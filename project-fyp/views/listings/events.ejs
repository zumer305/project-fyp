<% layout("/layouts/boiler")%>

<style>
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  body {
    font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    min-height: 100vh;
  }

  .events-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 40px 20px;
  }

  .header-section {
    background: white;
    padding: 30px;
    border-radius: 20px;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.1);
    margin-bottom: 30px;
    text-align: center;
  }

  .header-section h1 {
    color: #667eea;
    font-size: 2.5rem;
    margin-bottom: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 15px;
  }

  .header-section h1 .emoji {
    font-size: 3rem;
  }

  .destination-name {
    font-size: 1.3rem;
    color: #764ba2;
    font-weight: 600;
    margin-top: 10px;
  }

  .location-info {
    display: flex;
    justify-content: center;
    gap: 20px;
    margin-top: 15px;
    flex-wrap: wrap;
  }

  .info-badge {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    padding: 8px 20px;
    border-radius: 20px;
    font-size: 0.9rem;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .loading-spinner {
    text-align: center;
    padding: 60px 20px;
    background: white;
    border-radius: 20px;
    margin: 20px 0;
  }

  .spinner {
    border: 5px solid #f3f3f3;
    border-top: 5px solid #667eea;
    border-radius: 50%;
    width: 60px;
    height: 60px;
    animation: spin 1s linear infinite;
    margin: 0 auto 20px;
  }

  @keyframes spin {
    0% {
      transform: rotate(0deg);
    }
    100% {
      transform: rotate(360deg);
    }
  }

  .events-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
    gap: 25px;
    margin-top: 20px;
  }

  .event-card {
    background: white;
    border-radius: 15px;
    overflow: hidden;
    box-shadow: 0 5px 20px rgba(0, 0, 0, 0.1);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    cursor: pointer;
  }

  .event-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
  }

  .event-header {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    padding: 20px;
    position: relative;
  }

  .event-emoji {
    font-size: 3rem;
    margin-bottom: 10px;
  }

  .event-name {
    font-size: 1.4rem;
    font-weight: 700;
    margin-bottom: 5px;
  }

  .event-type {
    font-size: 0.9rem;
    opacity: 0.9;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .event-body {
    padding: 25px;
  }

  .event-date {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 15px;
    font-size: 1.1rem;
    color: #667eea;
    font-weight: 600;
  }

  .event-description {
    color: #555;
    line-height: 1.6;
    margin-bottom: 20px;
    font-size: 0.95rem;
  }

  .event-details {
    display: grid;
    gap: 12px;
  }

  .detail-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px;
    background: #f8f9fa;
    border-radius: 8px;
    font-size: 0.9rem;
  }

  .detail-icon {
    font-size: 1.2rem;
  }

  .detail-label {
    font-weight: 600;
    color: #667eea;
    min-width: 80px;
  }

  .detail-value {
    color: #333;
  }

  .event-highlights {
    margin-top: 20px;
    padding-top: 20px;
    border-top: 2px solid #f0f0f0;
  }

  .highlights-title {
    font-weight: 700;
    color: #667eea;
    margin-bottom: 12px;
    font-size: 1rem;
  }

  .highlights-list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .highlight-tag {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    padding: 6px 14px;
    border-radius: 15px;
    font-size: 0.85rem;
  }

  .no-events {
    background: white;
    padding: 60px 40px;
    border-radius: 20px;
    text-align: center;
  }

  .no-events h2 {
    color: #667eea;
    font-size: 2rem;
    margin-bottom: 15px;
  }

  .no-events p {
    color: #666;
    font-size: 1.1rem;
  }

  .api-source {
    background: white;
    padding: 20px;
    border-radius: 15px;
    margin-top: 30px;
    text-align: center;
  }

  .api-source-title {
    color: #667eea;
    font-weight: 600;
    margin-bottom: 10px;
  }

  .api-source-name {
    color: #764ba2;
    font-size: 0.9rem;
  }

  .error-message {
    background: #fff3cd;
    border: 2px solid #ffc107;
    color: #856404;
    padding: 20px;
    border-radius: 15px;
    margin: 20px 0;
    text-align: center;
  }

  @media (max-width: 768px) {
    .events-grid {
      grid-template-columns: 1fr;
    }

    .header-section h1 {
      font-size: 2rem;
    }

    .location-info {
      flex-direction: column;
      align-items: center;
    }
  }
</style>

<div class="events-container">
  <!-- Header Section -->
  <div class="header-section">
    <h1>
      <span class="emoji">📅</span>
      Festivals & Events
    </h1>
    <div class="destination-name" id="destination-name">
      Loading destination...
    </div>
    <div class="location-info">
      <div class="info-badge">
        <span>📍</span>
        <span id="location-text">Fetching location...</span>
      </div>
      <div class="info-badge">
        <span>🗓️</span>
        <span id="current-date"></span>
      </div>
      <div class="info-badge">
        <span>🌐</span>
        <span>Real-time Data</span>
      </div>
    </div>
  </div>

  <!-- Loading Spinner -->
  <div class="loading-spinner" id="loading-spinner">
    <div class="spinner"></div>
    <h3>Fetching Events & Festivals...</h3>
    <p>Getting data from free public APIs</p>
  </div>

  <!-- Events Grid -->
  <div class="events-grid" id="events-grid" style="display: none">
    <!-- Events will be dynamically loaded here -->
  </div>

  <!-- API Source Info -->
  <div class="api-source" id="api-source" style="display: none">
    <div class="api-source-title">Data Source</div>
    <div class="api-source-name" id="source-name">Free Public APIs</div>
  </div>
</div>

<script>
  let eventsData = [];

  // Initialize on page load
  document.addEventListener("DOMContentLoaded", async () => {
    // Set current date
    const now = new Date();
    document.getElementById("current-date").textContent =
      now.toLocaleDateString("en-US", {
        month: "short",
        day: "numeric",
        year: "numeric",
      });

    // Get destination from localStorage
    const destination =
      localStorage.getItem("selectedDestination") || "Central Asia";
    const packageData = getStoredPackage();

    document.getElementById("destination-name").textContent = destination;
    document.getElementById("location-text").textContent = destination;

    // Fetch events
    await fetchEvents(destination, packageData);
  });

  function getStoredPackage() {
    try {
      const stored = localStorage.getItem("selectedPackage");
      if (stored) {
        return JSON.parse(stored);
      }
    } catch (e) {
      console.error("Error parsing package data:", e);
    }
    return null;
  }

  async function fetchEvents(destination, packageData) {
    try {
      // Get coordinates if available
      let lat = 41.3111; // Default to Tashkent
      let lng = 69.2797;

      if (packageData && packageData.destination) {
        lat = packageData.destination.latitude || lat;
        lng = packageData.destination.longitude || lng;
      }

      const response = await fetch(
        `/api/events?destination=${encodeURIComponent(
          destination
        )}&lat=${lat}&lng=${lng}`
      );
      const result = await response.json();

      console.log(
        `✅ Loaded ${result.data?.length || 0} events from FREE APIs (${
          result.source
        })`
      );

      document.getElementById("loading-spinner").style.display = "none";

      if (result.success && result.data && result.data.length > 0) {
        eventsData = result.data;
        renderEvents(eventsData);

        // Show API source
        document.getElementById("source-name").textContent =
          result.source || "Free Public APIs";
        document.getElementById("api-source").style.display = "block";
      } else {
        showNoEvents();
      }
    } catch (error) {
      console.error("❌ Error fetching events:", error);
      document.getElementById("loading-spinner").style.display = "none";
      showErrorMessage("Unable to load events. Please refresh the page.");
    }
  }

  function renderEvents(events) {
    const grid = document.getElementById("events-grid");
    grid.innerHTML = "";
    grid.style.display = "grid";

    events.forEach((event) => {
      const card = createEventCard(event);
      grid.appendChild(card);
    });
  }

  function createEventCard(event) {
    const card = document.createElement("div");
    card.className = "event-card";

    const highlightsHTML =
      event.highlights && event.highlights.length > 0
        ? `
        <div class="event-highlights">
          <div class="highlights-title">✨ Highlights</div>
          <div class="highlights-list">
            ${event.highlights
              .map((h) => `<span class="highlight-tag">${h}</span>`)
              .join("")}
          </div>
        </div>
      `
        : "";

    card.innerHTML = `
      <div class="event-header">
        <div class="event-emoji">${event.emoji || "🎉"}</div>
        <div class="event-name">${event.name}</div>
        <div class="event-type">${event.type || "Festival"}</div>
      </div>
      <div class="event-body">
        <div class="event-date">
          <span>📅</span>
          <span>${event.date || "Date TBA"}</span>
        </div>
        <div class="event-description">
          ${
            event.description ||
            "A wonderful cultural event celebrating local traditions."
          }
        </div>
        <div class="event-details">
          ${
            event.location
              ? `
            <div class="detail-item">
              <span class="detail-icon">📍</span>
              <span class="detail-label">Location:</span>
              <span class="detail-value">${event.location}</span>
            </div>
          `
              : ""
          }
          ${
            event.duration
              ? `
            <div class="detail-item">
              <span class="detail-icon">⏱️</span>
              <span class="detail-label">Duration:</span>
              <span class="detail-value">${event.duration}</span>
            </div>
          `
              : ""
          }
          ${
            event.price
              ? `
            <div class="detail-item">
              <span class="detail-icon">💰</span>
              <span class="detail-label">Price:</span>
              <span class="detail-value">${event.price}</span>
            </div>
          `
              : ""
          }
          ${
            event.attendance
              ? `
            <div class="detail-item">
              <span class="detail-icon">👥</span>
              <span class="detail-label">Expected:</span>
              <span class="detail-value">${event.attendance}</span>
            </div>
          `
              : ""
          }
        </div>
        ${highlightsHTML}
      </div>
    `;

    return card;
  }

  function showNoEvents() {
    const grid = document.getElementById("events-grid");
    grid.innerHTML = `
      <div class="no-events">
        <h2>No Events Found</h2>
        <p>We couldn't find any events for this destination at the moment.</p>
        <p style="margin-top: 10px; font-size: 0.9rem; color: #999;">Try selecting a different destination or check back later.</p>
      </div>
    `;
    grid.style.display = "block";
  }

  function showErrorMessage(message) {
    const grid = document.getElementById("events-grid");
    grid.innerHTML = `
      <div class="error-message">
        <h3>⚠️ Error</h3>
        <p>${message}</p>
      </div>
    `;
    grid.style.display = "block";
  }

  function saveEventsContext() {
    // Save context for potential future use
    const destination = document.getElementById("destination-name").textContent;
    localStorage.setItem("lastViewedEvents", destination);
  }

  // Initialize currency converter and handle currency changes
  document.addEventListener("DOMContentLoaded", function () {
    // Handle currency changes for event prices
    document.addEventListener('currencyChanged', async (e) => {
      const newCurrency = e.detail.currency;
      await updateEventPrices(newCurrency);
    });
  });

  // Update event prices when currency changes
  async function updateEventPrices(currency) {
    const priceElements = document.querySelectorAll('.detail-value');
    
    for (const element of priceElements) {
      const priceText = element.textContent;
      
      // Check if this is a price element (contains PKR or Free)
      if (priceText.includes('PKR') || priceText.includes('Free')) {
        if (priceText === 'Free' || priceText.includes('Free')) {
          continue; // Don't convert free events
        }
        
        // Extract numeric values from PKR prices (e.g., "PKR 500-2000")
        const match = priceText.match(/PKR\s+([\d,]+)(?:-([\d,]+))?/);
        if (match) {
          const minPrice = parseFloat(match[1].replace(/,/g, ''));
          const maxPrice = match[2] ? parseFloat(match[2].replace(/,/g, '')) : null;
          
          if (currency === 'USD' || currency === 'PKR') {
            // Keep original format if USD or PKR
            continue;
          }
          
          // Convert to selected currency
          const minResult = await CurrencyConverter.convert(minPrice, 'PKR', currency);
          
          if (minResult.success) {
            if (maxPrice) {
              const maxResult = await CurrencyConverter.convert(maxPrice, 'PKR', currency);
              const symbol = CurrencyConverter.getSymbol(currency);
              element.textContent = `${symbol} ${minResult.result.toFixed(0)}-${maxResult.result.toFixed(0)}`;
            } else {
              element.textContent = CurrencyConverter.formatCurrency(minResult.result, currency);
            }
          }
        }
      }
    }
  }
</script>
