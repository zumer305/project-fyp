<% layout("/layouts/boiler") %>

<body>
  <div class="container mt-4">
    <div class="row g-4">
      <!-- LEFT: Listing details -->
      <div class="col-lg-6">
        <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
          <% const owner = listing.owner; %>
          <img
            src="<%= listing.image.url %>"
            class="card-img-top show-img"
            alt="listing_image"
            style="height: 350px; object-fit: cover"
          />
          <div class="card-body">
            <h3 class="fw-bold mb-2 text-dark"><%= listing.title %></h3>
            <p class="text-muted mb-1">
              Owned by:
              <i><%= owner && owner.username ? owner.username : "Host" %></i>
            </p>
            <p class="mb-1"><%= listing.description %></p>
            <p class="fw-semibold text-success">
              <span
                class="price-display"
                data-price="<%= listing.price %>"
                data-currency="USD"
              ></span>
            </p>
            <p class="mb-0">
              <i class="bi bi-geo-alt"></i> <%= listing.location %>, <%=
              listing.country %>
            </p>

            <% if (currUser && owner && owner._id &&
            owner._id.equals(currUser._id)) { %>
            <div class="mt-4 d-flex gap-3">
              <a
                href="/listings/<%= listing._id %>/edit/"
                class="btn btn-primary flex-fill rounded-pill"
                style="font-weight: 600"
              >
                <i class="bi bi-pencil-square me-2"></i>Edit
              </a>
              <form
                method="POST"
                action="/listings/<%= listing._id %>?_method=DELETE"
                class="flex-fill"
              >
                <button
                  class="btn btn-danger w-100 rounded-pill"
                  style="font-weight: 600"
                >
                  <i class="bi bi-trash3 me-2"></i>Delete
                </button>
              </form>
            </div>
            <% } %>
          </div>
        </div>

        <!-- Emergency section -->
        <div class="mt-4 p-3 bg-light rounded-4 shadow-sm">
          <h4 class="text-danger mb-3">🚨 Stay Safe – Know Who to Call</h4>

          <div id="emergency-contacts">
            <div class="text-center py-3">
              <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- RIGHT: Reviews -->
      <div class="col-lg-6">
        <% if (currUser) { %>
        <div class="card border-0 shadow-sm rounded-4 mb-4 p-3">
          <h4 class="fw-semibold mb-3">Leave a Review</h4>
          <form
            action="/listings/<%= listing.id %>/reviews"
            method="POST"
            novalidate
            class="needs-validation"
          >
            <label class="form-label">Rating</label>
            <fieldset
              class="starability-slot"
              style="display: inline-block; vertical-align: middle"
            >
              <input
                type="radio"
                id="first-rate1"
                name="review[rating]"
                value="1"
              />
              <label for="first-rate1" title="Terrible">1 star</label>
              <input
                type="radio"
                id="first-rate2"
                name="review[rating]"
                value="2"
              />
              <label for="first-rate2" title="Not good">2 stars</label>
              <input
                type="radio"
                id="first-rate3"
                name="review[rating]"
                value="3"
              />
              <label for="first-rate3" title="Average">3 stars</label>
              <input
                type="radio"
                id="first-rate4"
                name="review[rating]"
                value="4"
              />
              <label for="first-rate4" title="Very good">4 stars</label>
              <input
                type="radio"
                id="first-rate5"
                name="review[rating]"
                value="5"
                checked
              />
              <label for="first-rate5" title="Amazing">5 stars</label>
            </fieldset>

            <div class="mt-3">
              <label for="comment" class="form-label">Comment</label>
              <textarea
                name="review[comment]"
                id="comment"
                rows="4"
                class="form-control"
                required
              ></textarea>
              <div class="invalid-feedback">Please add some comments.</div>
            </div>

            <button class="btn btn-outline-dark mt-3 w-100">Submit</button>
          </form>
        </div>
        <% } %>

        <h5 class="fw-bold text-dark mb-3">⭐ All Reviews</h5>
        <div
          class="reviews-container overflow-auto"
          style="max-height: 320px; scrollbar-width: thin"
        >
          <% if (listing.reviews.length === 0) { %>
          <p class="text-muted">
            No reviews yet. Be the first to share your thoughts!
          </p>
          <% } %> <% for (review of listing.reviews) { %>
          <div class="card border-0 shadow-sm mb-3 rounded-4">
            <div class="card-body">
              <h6 class="card-title mb-1 text-dark">
                @<%= review.author.username %>
              </h6>
              <p
                class="starability-result card-text mb-1"
                data-rating="<%= review.rating %>"
                style="line-height: 1"
              ></p>
              <p class="card-text mb-2"><%= review.comment %></p>

              <% if (currUser && currUser._id.equals(review.author._id)) { %>
              <div class="d-flex justify-content-end">
                <form
                  method="POST"
                  action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE"
                >
                  <button
                    class="btn btn-sm btn-outline-danger rounded-pill px-3"
                  >
                    Delete
                  </button>
                </form>
              </div>
              <% } %>
            </div>
          </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>

  <script>
    // Initialize prices on page load
    document.addEventListener("DOMContentLoaded", async function () {
      await updateAllPrices();
    });

    // Handle currency changes
    document.addEventListener("currencyChanged", async (e) => {
      await updateAllPrices();
    });

    async function updateAllPrices() {
      const currentCurrency = CurrencyConverter.getUserCurrency();
      const priceElements = document.querySelectorAll("[data-price]");

      if (priceElements.length === 0) return;

      // Group by currency
      const currencyGroups = {};
      priceElements.forEach((element) => {
        const fromCurrency = element.getAttribute("data-currency") || "USD";
        if (!currencyGroups[fromCurrency]) {
          currencyGroups[fromCurrency] = [];
        }
        currencyGroups[fromCurrency].push(element);
      });

      // ONE API call per currency pair
      for (const fromCurrency in currencyGroups) {
        const elements = currencyGroups[fromCurrency];

        if (currentCurrency === fromCurrency) {
          elements.forEach((element) => {
            const originalPrice = parseFloat(
              element.getAttribute("data-price")
            );
            if (!isNaN(originalPrice)) {
              element.textContent = `${fromCurrency} ${originalPrice.toLocaleString()}`;
            }
          });
        } else {
          const rateResult = await CurrencyConverter.getExchangeRate(
            fromCurrency,
            currentCurrency
          );

          if (rateResult.success) {
            elements.forEach((element) => {
              const originalPrice = parseFloat(
                element.getAttribute("data-price")
              );
              if (!isNaN(originalPrice)) {
                const convertedAmount = CurrencyConverter.convertWithRate(
                  originalPrice,
                  rateResult.rate
                );
                element.textContent = CurrencyConverter.formatCurrency(
                  convertedAmount,
                  currentCurrency
                );
              }
            });
          }
        }
      }
    }
  </script>

  <script>
    // Fetch and display emergency contacts from API
    document.addEventListener("DOMContentLoaded", async function () {
      const country = "<%= listing.country %>";
      const emergencyContainer = document.getElementById("emergency-contacts");

      try {
        const response = await fetch(`/api/emergency/${country}`);
        const result = await response.json();

        if (result.success) {
          const data = result.data;

          emergencyContainer.innerHTML = `
            <div class="d-flex align-items-center mb-3">
              <div class="fs-2 me-3">👮</div>
              <div>
                <h6 class="mb-0">Local Police</h6>
                <small><strong>${data.country} Police</strong> – Dial ${data.police}</small>
              </div>
            </div>

            <div class="d-flex align-items-center mb-3">
              <div class="fs-2 me-3">🚑</div>
              <div>
                <h6 class="mb-0">Emergency Ambulance</h6>
                <small>Dial <strong>${data.ambulance}</strong> for medical emergencies</small>
              </div>
            </div>

            <div class="d-flex align-items-center mb-3">
              <div class="fs-2 me-3">🏥</div>
              <div>
                <h6 class="mb-0">Nearby Hospital</h6>
                <small><strong>${data.hospitals[0].name}</strong><br>
                ${data.hospitals[0].phone}</small>
              </div>
            </div>

            <div class="d-flex align-items-center mb-3">
              <div class="fs-2 me-3">🏢</div>
              <div>
                <h6 class="mb-0">Pakistan Embassy</h6>
                <small><strong>${data.embassy.name}</strong><br>
                ${data.embassy.phone}</small>
              </div>
            </div>

            <div class="d-flex align-items-center mb-3">
              <div class="fs-2 me-3">🔥</div>
              <div>
                <h6 class="mb-0">Fire Department</h6>
                <small>Dial <strong>${data.fire}</strong> for fire emergencies</small>
              </div>
            </div>
          `;
        } else {
          emergencyContainer.innerHTML = `
            <div class="alert alert-warning">
              <i class="bi bi-exclamation-triangle"></i> 
              Emergency contacts not available for this location.
            </div>
          `;
        }
      } catch (error) {
        console.error("Error fetching emergency contacts:", error);
        emergencyContainer.innerHTML = `
          <div class="alert alert-danger">
            <i class="bi bi-x-circle"></i> 
            Failed to load emergency contacts. Please refresh the page.
          </div>
        `;
      }
    });
  </script>
</body>
