<% layout("/layouts/boiler")%>

<style>
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  body {
    font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    min-height: 100vh;
  }

  .eventbrite-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 40px 20px;
  }

  .header-section {
    background: white;
    padding: 30px;
    border-radius: 20px;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.15);
    margin-bottom: 30px;
    text-align: center;
  }

  .header-section h1 {
    color: #667eea;
    font-size: 2.5rem;
    margin-bottom: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 15px;
  }

  .header-section h1 .emoji {
    font-size: 3rem;
  }

  .search-section {
    background: white;
    padding: 25px;
    border-radius: 15px;
    box-shadow: 0 5px 20px rgba(0, 0, 0, 0.1);
    margin-bottom: 30px;
  }

  .search-form {
    display: flex;
    gap: 15px;
    flex-wrap: wrap;
    align-items: end;
  }

  .form-group {
    flex: 1;
    min-width: 200px;
  }

  .form-group label {
    display: block;
    margin-bottom: 5px;
    font-weight: 600;
    color: #333;
  }

  .form-group input,
  .form-group select {
    width: 100%;
    padding: 12px;
    border: 2px solid #e0e0e0;
    border-radius: 10px;
    font-size: 1rem;
    transition: border-color 0.3s;
  }

  .form-group input:focus,
  .form-group select:focus {
    outline: none;
    border-color: #667eea;
  }

  .search-btn {
    padding: 12px 30px;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    border: none;
    border-radius: 10px;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    transition: transform 0.2s;
  }

  .search-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 5px 15px rgba(102, 126, 234, 0.3);
  }

  .events-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
    gap: 25px;
    margin-top: 30px;
  }

  .event-card {
    background: white;
    border-radius: 15px;
    overflow: hidden;
    box-shadow: 0 5px 20px rgba(0, 0, 0, 0.1);
    transition: transform 0.3s, box-shadow 0.3s;
    cursor: pointer;
    display: flex;
    flex-direction: column;
  }

  .event-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
  }

  .event-image {
    width: 100%;
    height: 200px;
    object-fit: cover;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  }

  .event-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .event-content {
    padding: 20px;
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .event-title {
    font-size: 1.3rem;
    font-weight: 700;
    color: #333;
    margin-bottom: 10px;
    line-height: 1.4;
  }

  .event-date {
    display: flex;
    align-items: center;
    gap: 8px;
    color: #667eea;
    font-weight: 600;
    margin-bottom: 8px;
  }

  .event-location {
    display: flex;
    align-items: center;
    gap: 8px;
    color: #666;
    margin-bottom: 10px;
  }

  .event-description {
    color: #777;
    font-size: 0.95rem;
    line-height: 1.6;
    margin-bottom: 15px;
    flex: 1;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .event-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 15px;
    border-top: 1px solid #e0e0e0;
  }

  .event-price {
    font-size: 1.2rem;
    font-weight: 700;
    color: #667eea;
  }

  .event-price.free {
    color: #27ae60;
  }

  .event-btn {
    padding: 10px 20px;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    border: none;
    border-radius: 8px;
    font-weight: 600;
    cursor: pointer;
    text-decoration: none;
    transition: transform 0.2s;
  }

  .event-btn:hover {
    transform: scale(1.05);
    color: white;
  }

  .event-badge {
    display: inline-block;
    padding: 5px 12px;
    border-radius: 20px;
    font-size: 0.85rem;
    font-weight: 600;
    margin-bottom: 10px;
  }

  .badge-online {
    background: #3498db;
    color: white;
  }

  .badge-category {
    background: #f39c12;
    color: white;
  }

  .loading {
    text-align: center;
    padding: 60px 20px;
    color: white;
    font-size: 1.2rem;
  }

  .no-events {
    text-align: center;
    padding: 60px 20px;
    background: white;
    border-radius: 15px;
    box-shadow: 0 5px 20px rgba(0, 0, 0, 0.1);
  }

  .no-events h3 {
    color: #666;
    font-size: 1.5rem;
    margin-bottom: 10px;
  }

  .error-message {
    background: #ff4757;
    color: white;
    padding: 20px;
    border-radius: 10px;
    margin: 20px 0;
    text-align: center;
  }

  #map {
    height: 400px;
    border-radius: 15px;
    margin-top: 30px;
    box-shadow: 0 5px 20px rgba(0, 0, 0, 0.1);
  }

  .map-section {
    background: white;
    padding: 25px;
    border-radius: 15px;
    box-shadow: 0 5px 20px rgba(0, 0, 0, 0.1);
    margin-bottom: 30px;
  }

  .map-section h3 {
    color: #333;
    margin-bottom: 15px;
  }

  @media (max-width: 768px) {
    .events-grid {
      grid-template-columns: 1fr;
    }

    .search-form {
      flex-direction: column;
    }

    .form-group {
      width: 100%;
    }

    .header-section h1 {
      font-size: 2rem;
    }
  }
</style>

<div class="eventbrite-container">
  <div class="header-section">
    <h1>
      <span class="emoji">🎉</span>
      Live Local Events
      <span class="emoji">🎊</span>
    </h1>
    <p style="color: #666; font-size: 1.1rem; margin-top: 10px">
      Discover LIVE events happening in cities worldwide - powered by real-time APIs
    </p>
  </div>

  <div class="search-section">
    <form class="search-form" id="eventSearchForm">
      <div class="form-group">
        <label for="location">📍 Location</label>
        <input
          type="text"
          id="location"
          name="location"
          placeholder="City or Address"
          value=""
        />
      </div>

      <div class="form-group">
        <label for="radius">🌍 Radius (km)</label>
        <select id="radius" name="radius">
          <option value="10">10 km</option>
          <option value="25">25 km</option>
          <option value="50" selected>50 km</option>
          <option value="100">100 km</option>
          <option value="200">200 km</option>
        </select>
      </div>

      <div class="form-group">
        <label for="sort">📊 Sort By</label>
        <select id="sort" name="sort">
          <option value="date">Date</option>
          <option value="distance">Distance</option>
          <option value="best">Best Match</option>
        </select>
      </div>

      <button type="submit" class="search-btn">🔍 Search Events</button>
      <button type="button" class="search-btn" style="background: linear-gradient(135deg, #95a5a6 0%, #7f8c8d 100%);" onclick="clearLocationCache()">
        🗑️ Clear Cache
      </button>
    </form>
  </div>

  <div id="loadingMessage" class="loading" style="display: none">
    🔄 Loading events...
  </div>

  <div id="errorMessage" class="error-message" style="display: none"></div>

  <!-- Map Section -->
  <div class="map-section" id="mapSection" style="display: none">
    <h3>📍 Event Locations</h3>
    <div id="map"></div>
  </div>

  <!-- Events Grid -->
  <div class="events-grid" id="eventsGrid"></div>

  <div class="no-events" id="noEvents" style="display: none">
    <h3>😕 No events found</h3>
    <p>Try changing your search location or radius</p>
  </div>
</div>

<!-- Leaflet CSS for Map -->
<link
  rel="stylesheet"
  href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
/>

<!-- Leaflet JS for Map -->
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

<script>
  let map = null;
  let markers = [];

  // Initialize map
  function initMap() {
    if (!map) {
      map = L.map("map").setView([41.3111, 69.2797], 11);
      L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
        attribution: "© OpenStreetMap contributors",
      }).addTo(map);
    }
  }

  // Add markers to map
  function addEventMarkers(events) {
    // Clear existing markers
    markers.forEach((marker) => marker.remove());
    markers = [];

    const bounds = [];

    events.forEach((event) => {
      if (event.venue && event.venue.latitude && event.venue.longitude) {
        const lat = parseFloat(event.venue.latitude);
        const lng = parseFloat(event.venue.longitude);

        const marker = L.marker([lat, lng])
          .addTo(map)
          .bindPopup(
            `<strong>${event.name}</strong><br>${event.venue.name}<br><a href="${event.url}" target="_blank">View Event</a>`
          );

        markers.push(marker);
        bounds.push([lat, lng]);
      }
    });

    // Fit map to show all markers
    if (bounds.length > 0) {
      map.fitBounds(bounds, { padding: [50, 50] });
    }
  }

  // Format date
  function formatDate(dateString) {
    const date = new Date(dateString);
    const options = {
      weekday: "short",
      year: "numeric",
      month: "short",
      day: "numeric",
      hour: "2-digit",
      minute: "2-digit",
    };
    return date.toLocaleDateString("en-US", options);
  }

  // Create event card HTML
  function createEventCard(event) {
    // Handle different date formats from different APIs
    let startDate = "Date TBA";
    if (event.start) {
      if (event.start.local) {
        startDate = formatDate(event.start.local);
      } else if (event.start.utc) {
        startDate = formatDate(event.start.utc);
      } else if (typeof event.start === 'string') {
        startDate = formatDate(event.start);
      }
    } else if (event.date) {
      startDate = formatDate(event.date);
    } else if (event.startDate) {
      startDate = formatDate(event.startDate);
    }

    const isFree = event.isFree || event.is_free || event.free || false;
    const isOnline = event.onlineEvent || event.online_event || event.isOnline || false;

    let imageHtml = "";
    if (event.logo || event.images) {
      const imgSrc = event.logo || event.images;
      imageHtml = `<img src="${imgSrc}" alt="${event.name}" />`;
    }

    const venueName = event.venue ? event.venue.name : "Online Event";
    const venueAddress = event.venue
      ? event.venue.address?.localized_address_display || ""
      : "";

    return `
      <div class="event-card">
        <div class="event-image">
          ${imageHtml}
        </div>
        <div class="event-content">
          ${
            isOnline
              ? '<span class="event-badge badge-online">🌐 Online Event</span>'
              : ""
          }
          ${
            event.category
              ? `<span class="event-badge badge-category">${event.category.name}</span>`
              : ""
          }
          ${
            event.apiSource
              ? `<span class="event-badge" style="background: #3498db; color: white;">${event.apiSource}</span>`
              : ""
          }
          <h3 class="event-title">${event.name}</h3>
          <div class="event-date">
            <span>📅</span>
            <span>${startDate}</span>
          </div>
          <div class="event-location">
            <span>📍</span>
            <span>${venueName}</span>
          </div>
          ${
            event.description
              ? `<p class="event-description">${event.description.substring(0, 150)}...</p>`
              : ""
          }
          <div class="event-footer">
            <div class="event-price ${isFree ? "free" : ""}">
              ${isFree ? "FREE" : (event.price || "Paid Event")}
            </div>
            <a href="${event.url || '#'}" target="_blank" class="event-btn">
              View Details →
            </a>
          </div>
        </div>
      </div>
    `;
  }

  // Search events - Uses FREE public APIs that work for ANY city
  async function searchEvents(location, radius, sort) {
    const loadingEl = document.getElementById("loadingMessage");
    const errorEl = document.getElementById("errorMessage");
    const gridEl = document.getElementById("eventsGrid");
    const noEventsEl = document.getElementById("noEvents");
    const mapSectionEl = document.getElementById("mapSection");

    console.log(`🔍 Searching for events in: ${location}`);

    // Show loading
    loadingEl.style.display = "block";
    errorEl.style.display = "none";
    gridEl.innerHTML = "";
    noEventsEl.style.display = "none";
    mapSectionEl.style.display = "none";

    try {
      // First, try to get coordinates for the location using geocoding
      let lat = null;
      let lng = null;
      
      // Use a free geocoding service to convert city name to coordinates
      try {
        console.log(`📍 Geocoding: ${location}...`);
        const geocodeResponse = await fetch(
          `https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(location)}`,
          {
            headers: {
              'User-Agent': 'TravelEventsApp/1.0'
            }
          }
        );
        const geocodeData = await geocodeResponse.json();
        if (geocodeData && geocodeData.length > 0) {
          lat = geocodeData[0].lat;
          lng = geocodeData[0].lon;
          console.log(`✅ Found coordinates for ${location}: ${lat}, ${lng}`);
        } else {
          console.warn(`⚠️  No coordinates found for ${location}`);
        }
      } catch (geocodeError) {
        console.error("❌ Geocoding failed:", geocodeError);
      }

      // Use your FREE events API (works for ANY city, no special token needed!)
      const params = new URLSearchParams({
        destination: location,
      });
      
      if (lat && lng) {
        params.append('lat', lat);
        params.append('lng', lng);
        console.log(`🌐 Fetching events with coordinates: ${lat}, ${lng}`);
      } else {
        console.log(`🌐 Fetching events by name: ${location}`);
      }

      console.log(`📡 API Call: /api/events?${params.toString()}`);
      const response = await fetch(`/api/events?${params}`);
      const data = await response.json();

      console.log(`📊 API Response:`, data);

      loadingEl.style.display = "none";

      if (!data.success) {
        throw new Error(data.error || data.message || "Failed to fetch events");
      }

      if (data.data && data.data.length > 0) {
        console.log(`✅ Found ${data.data.length} events!`);
        
        // Display events
        gridEl.innerHTML = data.data.map((event) => createEventCard(event)).join("");

        // Show map with markers if events have coordinates
        const eventsWithCoords = data.data.filter(e => e.venue?.latitude && e.venue?.longitude);
        if (eventsWithCoords.length > 0) {
          mapSectionEl.style.display = "block";
          initMap();
          addEventMarkers(eventsWithCoords);
        } else if (lat && lng) {
          // Show map centered on searched location even if no event coords
          mapSectionEl.style.display = "block";
          initMap();
          map.setView([lat, lng], 12);
          L.marker([lat, lng])
            .addTo(map)
            .bindPopup(`<b>${location}</b><br>Showing events in this area`);
        }
      } else {
        console.warn(`⚠️  No events found for ${location}`);
        console.log('API message:', data.message);
        
        // Show the API message if available
        if (data.message) {
          noEventsEl.innerHTML = `
            <h3>😕 No events found</h3>
            <p>${data.message}</p>
            <p style="margin-top: 15px;">💡 Try searching for major cities like:</p>
            <p><strong>London, New York, Paris, Tokyo, Sydney, Toronto, Berlin</strong></p>
          `;
        }
        
        noEventsEl.style.display = "block";
      }
    } catch (error) {
      loadingEl.style.display = "none";
      console.error("❌ Error fetching events:", error);
      errorEl.textContent = `Error: ${error.message}`;
      errorEl.style.display = "block";
    }
  }

  // Form submission
  document
    .getElementById("eventSearchForm")
    .addEventListener("submit", function (e) {
      e.preventDefault();

      const location = document.getElementById("location").value;
      const radius = document.getElementById("radius").value;
      const sort = document.getElementById("sort").value;

      // Save location to localStorage (browser cache)
      if (location) {
        localStorage.setItem("lastSearchedLocation", location);
        localStorage.setItem("lastSearchedRadius", radius);
        localStorage.setItem("lastSearchedSort", sort);
      }

      searchEvents(location, radius, sort);
    });

  // Load events on page load with cached location
  window.addEventListener("DOMContentLoaded", function () {
    // Try to get saved location from localStorage (browser cache)
    const savedLocation = localStorage.getItem("lastSearchedLocation");
    const savedRadius = localStorage.getItem("lastSearchedRadius");
    const savedSort = localStorage.getItem("lastSearchedSort");

    // Set the form values from cache
    const locationInput = document.getElementById("location");
    const radiusSelect = document.getElementById("radius");
    const sortSelect = document.getElementById("sort");

    if (savedLocation) {
      locationInput.value = savedLocation;
      console.log(`✅ Loaded saved location from cache: ${savedLocation}`);
    } else {
      // Default location if nothing in cache - use a city with more events
      locationInput.value = "New York, USA";
      console.log(`📍 Using default location: New York, USA`);
    }

    if (savedRadius) {
      radiusSelect.value = savedRadius;
    }

    if (savedSort) {
      sortSelect.value = savedSort;
    }

    const location = locationInput.value;
    const radius = radiusSelect.value;
    const sort = sortSelect.value;

    console.log(`🚀 Page loaded - searching for events in: ${location}`);
    
    // Small delay to ensure everything is ready
    setTimeout(() => {
      searchEvents(location, radius, sort);
    }, 100);
  });

  // Clear location cache
  function clearLocationCache() {
    localStorage.removeItem("lastSearchedLocation");
    localStorage.removeItem("lastSearchedRadius");
    localStorage.removeItem("lastSearchedSort");
    
    // Reset to defaults
    document.getElementById("location").value = "New York, USA";
    document.getElementById("radius").value = "50";
    document.getElementById("sort").value = "date";
    
    alert("✅ Location cache cleared! Default location restored.");
    
    // Reload events with default location
    searchEvents("New York, USA", "50", "date");
  }
</script>
