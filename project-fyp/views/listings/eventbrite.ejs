<% layout("/layouts/boiler")%>

<style>
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  body {
    font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
    background: linear-gradient(135deg, #ff6b6b 0%, #ee5a6f 50%, #c44569 100%);
    min-height: 100vh;
  }

  .eventbrite-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 40px 20px;
  }

  .header-section {
    background: white;
    padding: 30px;
    border-radius: 20px;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.15);
    margin-bottom: 30px;
    text-align: center;
  }

  .header-section h1 {
    color: #ff6b6b;
    font-size: 2.5rem;
    margin-bottom: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 15px;
  }

  .header-section h1 .emoji {
    font-size: 3rem;
  }

  .search-section {
    background: white;
    padding: 25px;
    border-radius: 15px;
    box-shadow: 0 5px 20px rgba(0, 0, 0, 0.1);
    margin-bottom: 30px;
  }

  .search-form {
    display: flex;
    gap: 15px;
    flex-wrap: wrap;
    align-items: end;
  }

  .form-group {
    flex: 1;
    min-width: 200px;
  }

  .form-group label {
    display: block;
    margin-bottom: 5px;
    font-weight: 600;
    color: #333;
  }

  .form-group input,
  .form-group select {
    width: 100%;
    padding: 12px;
    border: 2px solid #e0e0e0;
    border-radius: 10px;
    font-size: 1rem;
    transition: border-color 0.3s;
  }

  .form-group input:focus,
  .form-group select:focus {
    outline: none;
    border-color: #ff6b6b;
  }

  .search-btn {
    padding: 12px 30px;
    background: linear-gradient(135deg, #ff6b6b 0%, #ee5a6f 100%);
    color: white;
    border: none;
    border-radius: 10px;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    transition: transform 0.2s;
  }

  .search-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 5px 15px rgba(255, 107, 107, 0.3);
  }

  .events-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
    gap: 25px;
    margin-top: 30px;
  }

  .event-card {
    background: white;
    border-radius: 15px;
    overflow: hidden;
    box-shadow: 0 5px 20px rgba(0, 0, 0, 0.1);
    transition: transform 0.3s, box-shadow 0.3s;
    cursor: pointer;
    display: flex;
    flex-direction: column;
  }

  .event-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
  }

  .event-image {
    width: 100%;
    height: 200px;
    object-fit: cover;
    background: linear-gradient(135deg, #ff6b6b 0%, #ee5a6f 100%);
  }

  .event-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .event-content {
    padding: 20px;
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .event-title {
    font-size: 1.3rem;
    font-weight: 700;
    color: #333;
    margin-bottom: 10px;
    line-height: 1.4;
  }

  .event-date {
    display: flex;
    align-items: center;
    gap: 8px;
    color: #ff6b6b;
    font-weight: 600;
    margin-bottom: 8px;
  }

  .event-location {
    display: flex;
    align-items: center;
    gap: 8px;
    color: #666;
    margin-bottom: 10px;
  }

  .event-description {
    color: #777;
    font-size: 0.95rem;
    line-height: 1.6;
    margin-bottom: 15px;
    flex: 1;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .event-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 15px;
    border-top: 1px solid #e0e0e0;
  }

  .event-price {
    font-size: 1.2rem;
    font-weight: 700;
    color: #ff6b6b;
  }

  .event-price.free {
    color: #27ae60;
  }

  .event-btn {
    padding: 10px 20px;
    background: linear-gradient(135deg, #ff6b6b 0%, #ee5a6f 100%);
    color: white;
    border: none;
    border-radius: 8px;
    font-weight: 600;
    cursor: pointer;
    text-decoration: none;
    transition: transform 0.2s;
  }

  .event-btn:hover {
    transform: scale(1.05);
    color: white;
  }

  .event-badge {
    display: inline-block;
    padding: 5px 12px;
    border-radius: 20px;
    font-size: 0.85rem;
    font-weight: 600;
    margin-bottom: 10px;
  }

  .badge-online {
    background: #3498db;
    color: white;
  }

  .badge-category {
    background: #f39c12;
    color: white;
  }

  .loading {
    text-align: center;
    padding: 60px 20px;
    color: white;
    font-size: 1.2rem;
  }

  .no-events {
    text-align: center;
    padding: 60px 20px;
    background: white;
    border-radius: 15px;
    box-shadow: 0 5px 20px rgba(0, 0, 0, 0.1);
  }

  .no-events h3 {
    color: #666;
    font-size: 1.5rem;
    margin-bottom: 10px;
  }

  .error-message {
    background: #ff4757;
    color: white;
    padding: 20px;
    border-radius: 10px;
    margin: 20px 0;
    text-align: center;
  }

  #map {
    height: 400px;
    border-radius: 15px;
    margin-top: 30px;
    box-shadow: 0 5px 20px rgba(0, 0, 0, 0.1);
  }

  .map-section {
    background: white;
    padding: 25px;
    border-radius: 15px;
    box-shadow: 0 5px 20px rgba(0, 0, 0, 0.1);
    margin-bottom: 30px;
  }

  .map-section h3 {
    color: #333;
    margin-bottom: 15px;
  }

  @media (max-width: 768px) {
    .events-grid {
      grid-template-columns: 1fr;
    }

    .search-form {
      flex-direction: column;
    }

    .form-group {
      width: 100%;
    }

    .header-section h1 {
      font-size: 2rem;
    }
  }
</style>

<div class="eventbrite-container">
  <div class="header-section">
    <h1>
      <span class="emoji">🎉</span>
      Discover Events on Eventbrite
      <span class="emoji">🎊</span>
    </h1>
    <p style="color: #666; font-size: 1.1rem; margin-top: 10px">
      Browse events and experiences worldwide
    </p>
    <p style="color: #ff6b6b; font-size: 0.9rem; margin-top: 5px">
      💡 <strong>Tip:</strong> Currently showing your Eventbrite events. For full public event search, upgrade your API token permissions.
    </p>
  </div>

  <div class="search-section">
    <form class="search-form" id="eventSearchForm">
      <div class="form-group">
        <label for="location">📍 Location</label>
        <input
          type="text"
          id="location"
          name="location"
          placeholder="City or Address"
          value="Tashkent, Uzbekistan"
        />
      </div>

      <div class="form-group">
        <label for="radius">🌍 Radius (km)</label>
        <select id="radius" name="radius">
          <option value="10">10 km</option>
          <option value="25">25 km</option>
          <option value="50" selected>50 km</option>
          <option value="100">100 km</option>
          <option value="200">200 km</option>
        </select>
      </div>

      <div class="form-group">
        <label for="sort">📊 Sort By</label>
        <select id="sort" name="sort">
          <option value="date">Date</option>
          <option value="distance">Distance</option>
          <option value="best">Best Match</option>
        </select>
      </div>

      <button type="submit" class="search-btn">🔍 Search Events</button>
    </form>
  </div>

  <div id="loadingMessage" class="loading" style="display: none">
    🔄 Loading events...
  </div>

  <div id="errorMessage" class="error-message" style="display: none"></div>

  <!-- Map Section -->
  <div class="map-section" id="mapSection" style="display: none">
    <h3>📍 Event Locations</h3>
    <div id="map"></div>
  </div>

  <!-- Events Grid -->
  <div class="events-grid" id="eventsGrid"></div>

  <div class="no-events" id="noEvents" style="display: none">
    <h3>😕 No events found</h3>
    <p>Try changing your search location or radius</p>
  </div>
</div>

<!-- Leaflet CSS for Map -->
<link
  rel="stylesheet"
  href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
/>

<!-- Leaflet JS for Map -->
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

<script>
  let map = null;
  let markers = [];

  // Initialize map
  function initMap() {
    if (!map) {
      map = L.map("map").setView([41.3111, 69.2797], 11);
      L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
        attribution: "© OpenStreetMap contributors",
      }).addTo(map);
    }
  }

  // Add markers to map
  function addEventMarkers(events) {
    // Clear existing markers
    markers.forEach((marker) => marker.remove());
    markers = [];

    const bounds = [];

    events.forEach((event) => {
      if (event.venue && event.venue.latitude && event.venue.longitude) {
        const lat = parseFloat(event.venue.latitude);
        const lng = parseFloat(event.venue.longitude);

        const marker = L.marker([lat, lng])
          .addTo(map)
          .bindPopup(
            `<strong>${event.name}</strong><br>${event.venue.name}<br><a href="${event.url}" target="_blank">View Event</a>`
          );

        markers.push(marker);
        bounds.push([lat, lng]);
      }
    });

    // Fit map to show all markers
    if (bounds.length > 0) {
      map.fitBounds(bounds, { padding: [50, 50] });
    }
  }

  // Format date
  function formatDate(dateString) {
    const date = new Date(dateString);
    const options = {
      weekday: "short",
      year: "numeric",
      month: "short",
      day: "numeric",
      hour: "2-digit",
      minute: "2-digit",
    };
    return date.toLocaleDateString("en-US", options);
  }

  // Create event card HTML
  function createEventCard(event) {
    const startDate = formatDate(event.start.local);
    const isFree = event.isFree;
    const isOnline = event.onlineEvent;

    let imageHtml = "";
    if (event.logo || event.images) {
      const imgSrc = event.logo || event.images;
      imageHtml = `<img src="${imgSrc}" alt="${event.name}" />`;
    }

    const venueName = event.venue ? event.venue.name : "Online Event";
    const venueAddress = event.venue
      ? event.venue.address?.localized_address_display || ""
      : "";

    return `
      <div class="event-card" onclick="window.open('${event.url}', '_blank')">
        <div class="event-image">
          ${imageHtml}
        </div>
        <div class="event-content">
          ${
            isOnline
              ? '<span class="event-badge badge-online">🌐 Online Event</span>'
              : ""
          }
          ${
            event.category
              ? `<span class="event-badge badge-category">${event.category.name}</span>`
              : ""
          }
          <h3 class="event-title">${event.name}</h3>
          <div class="event-date">
            <span>📅</span>
            <span>${startDate}</span>
          </div>
          <div class="event-location">
            <span>📍</span>
            <span>${venueName}</span>
          </div>
          ${
            event.description
              ? `<p class="event-description">${event.description.substring(0, 150)}...</p>`
              : ""
          }
          <div class="event-footer">
            <div class="event-price ${isFree ? "free" : ""}">
              ${isFree ? "FREE" : "Paid Event"}
            </div>
            <a href="${event.url}" target="_blank" class="event-btn" onclick="event.stopPropagation()">
              View Details →
            </a>
          </div>
        </div>
      </div>
    `;
  }

  // Search events
  async function searchEvents(location, radius, sort) {
    const loadingEl = document.getElementById("loadingMessage");
    const errorEl = document.getElementById("errorMessage");
    const gridEl = document.getElementById("eventsGrid");
    const noEventsEl = document.getElementById("noEvents");
    const mapSectionEl = document.getElementById("mapSection");

    // Show loading
    loadingEl.style.display = "block";
    errorEl.style.display = "none";
    gridEl.innerHTML = "";
    noEventsEl.style.display = "none";
    mapSectionEl.style.display = "none";

    try {
      const params = new URLSearchParams({
        location: location,
        radius: radius,
        sort: sort,
      });

      const response = await fetch(`/api/eventbrite/search?${params}`);
      const data = await response.json();

      loadingEl.style.display = "none";

      if (!data.success) {
        throw new Error(data.error || "Failed to fetch events");
      }

      if (data.data && data.data.length > 0) {
        // Display events
        gridEl.innerHTML = data.data.map((event) => createEventCard(event)).join("");

        // Show map with markers
        mapSectionEl.style.display = "block";
        initMap();
        addEventMarkers(data.data);
      } else {
        noEventsEl.style.display = "block";
      }
    } catch (error) {
      loadingEl.style.display = "none";
      errorEl.textContent = `Error: ${error.message}`;
      errorEl.style.display = "block";
      console.error("Error fetching events:", error);
    }
  }

  // Form submission
  document
    .getElementById("eventSearchForm")
    .addEventListener("submit", function (e) {
      e.preventDefault();

      const location = document.getElementById("location").value;
      const radius = document.getElementById("radius").value;
      const sort = document.getElementById("sort").value;

      searchEvents(location, radius, sort);
    });

  // Load events on page load
  window.addEventListener("DOMContentLoaded", function () {
    const location = document.getElementById("location").value;
    const radius = document.getElementById("radius").value;
    const sort = document.getElementById("sort").value;

    searchEvents(location, radius, sort);
  });
</script>
