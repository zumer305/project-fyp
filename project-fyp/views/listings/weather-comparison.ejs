    weatherMap.on("sourcedataloading", function (e) {
      if (e.sourceId && e.sourceId.includes("tiles")) {
        console.log("Loading tiles from:", e.sourceId);
      }
    });
  }

  // Add weather data layers using OpenWeatherMap tiles for full coverage
  function addWeatherTileLayers() {
    // OpenWeatherMap API key
    const owmApiKey = "586304a4438242f94f31e2848d5e3575";

    console.log(
      "Adding weather tile layers with API key:",
      owmApiKey.substring(0, 10) + "..."
    );

    // Check if layers already exist, if so, remove them first
    if (weatherMap.getLayer("temperature-layer")) {
      weatherMap.removeLayer("temperature-layer");
      weatherMap.removeSource("temperature-tiles");
    }

    // Temperature layer - covers all locations
    weatherMap.addSource("temperature-tiles", {
      type: "raster",
      tiles: [
        `https://tile.openweathermap.org/map/temp_new/{z}/{x}/{y}.png?appid=${owmApiKey}`,
      ],
      tileSize: 256,
      attribution: "Temperature data © OpenWeatherMap",
    });

    weatherMap.addLayer({
      id: "temperature-layer",
      type: "raster",
      source: "temperature-tiles",
      paint: { "raster-opacity": 0.8 },
      layout: { visibility: "none" },
    });

    console.log("Temperature layer added");

    // Check and remove precipitation layer if exists
    if (weatherMap.getLayer("precipitation-layer")) {
      weatherMap.removeLayer("precipitation-layer");
      weatherMap.removeSource("precipitation-tiles");
