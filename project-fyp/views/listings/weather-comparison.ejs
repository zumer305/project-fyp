  // Update weather layer data
  function updateWeatherLayerData(weatherData) {
    if (!weatherMap || !weatherMap.getSource) {
      console.warn("Map not ready yet, skipping weather layer data update");
      return;
    }

    const tempFeatures = [];
    const precipFeatures = [];
    const windFeatures = [];
    const cloudFeatures = [];

    weatherData.forEach((location) => {
      try {
        const weather = location.weather;
        const coords = [location.lon, location.lat];

        // Temperature feature
        tempFeatures.push({
          type: "Feature",
          geometry: { type: "Point", coordinates: coords },
          properties: { temperature: weather.current.temp_c },
        });

        // Precipitation feature
        precipFeatures.push({
          type: "Feature",
          geometry: { type: "Point", coordinates: coords },
          properties: { precipitation: weather.current.precip_mm },
        });

        // Wind feature
        windFeatures.push({
          type: "Feature",
          geometry: { type: "Point", coordinates: coords },
          properties: {
            windSpeed: weather.current.wind_kph,
            windDegree: weather.current.wind_degree,
          },
        });

        // Cloud feature
        cloudFeatures.push({
          type: "Feature",
          geometry: { type: "Point", coordinates: coords },
          properties: { cloud: weather.current.cloud },
        });
      } catch (err) {
        console.error("Error processing location:", location, err);
      }
    });

    // Update GeoJSON sources with safety checks
    try {
      const tempSource = weatherMap.getSource("temperature-data");
      if (tempSource) {
        tempSource.setData({
          type: "FeatureCollection",
          features: tempFeatures,
        });
      }

      const precipSource = weatherMap.getSource("precipitation-data");
      if (precipSource) {
        precipSource.setData({
          type: "FeatureCollection",
          features: precipFeatures,
        });
      }

      const windSource = weatherMap.getSource("wind-data");
      if (windSource) {
        windSource.setData({
          type: "FeatureCollection",
          features: windFeatures,
        });
      }

      const cloudsSource = weatherMap.getSource("clouds-data");
      if (cloudsSource) {
        cloudsSource.setData({
          type: "FeatureCollection",
          features: cloudFeatures,
        });
      }
    } catch (err) {
      console.error("Error updating weather layer sources:", err);
    }
  }

