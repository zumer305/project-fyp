  // Fetch weather for all Central Asian countries
  async function fetchAllWeatherData() {
    const apiKey = "520a2f952b9a44fdb27111656251412";

    try {
      const promises = centralAsianLocations.map(async (location) => {
        try {
          const response = await fetch(
            `https://api.weatherapi.com/v1/current.json?key=${apiKey}&q=${encodeURIComponent(
              location.city
            )}&aqi=no`
          );

          if (response.ok) {
            const data = await response.json();
            return {
              ...location,
              weather: data, // Store the full data object (has .current and .location)
              locationData: data.location,
            };
          }
        } catch (error) {
          console.error(`Failed to fetch weather for ${location.city}:`, error);
        }
        return null;
      });

      const results = await Promise.all(promises);
      const filtered = results.filter((r) => r !== null);
      console.log(`Successfully fetched weather for ${filtered.length} cities`);
      return filtered;
    } catch (error) {
      console.error("Weather fetch error:", error);
      return [];
    }
  }

  // Load and display weather data
  async function loadWeatherData() {
    const loadingOverlay = document.getElementById("loading-overlay");
    loadingOverlay.classList.remove("hidden");

    try {
      console.log("Starting weather data fetch...");
      const weatherData = await fetchAllWeatherData();
      console.log("Weather data received:", weatherData.length, "cities");

      if (weatherData.length === 0) {
        console.error("No weather data received from API");
        throw new Error("No weather data received");
      }

      console.log("Displaying weather on map...");
      displayWeatherOnMap(weatherData);

      // Wait a bit to ensure map is fully loaded before updating layer data
      setTimeout(() => {
        try {
          console.log("Updating weather layer data...");
          updateWeatherLayerData(weatherData);
        } catch (err) {
          console.error("Error updating weather layer data:", err);
        }
      }, 500);

      loadingOverlay.classList.add("hidden");
      console.log("Weather data loaded successfully!");
    } catch (error) {
      console.error("Error loading weather data:", error);
      console.error("Error details:", error.message, error.stack);
      alert("Unable to fetch weather data. Error: " + error.message);
      loadingOverlay.classList.add("hidden");
    }
  }

  // Display weather markers on map
  function displayWeatherOnMap(weatherData) {
    // Clear existing markers
    weatherMarkers.forEach((marker) => marker.remove());
    weatherMarkers = [];

    const bounds = new mapboxgl.LngLatBounds();

    weatherData.forEach((location) => {
      const weather = location.weather.current; // Access the current weather data

      // Create custom weather marker with size based on city importance
      const weatherElement = document.createElement("div");
      const isCapital = location.isCapital;
      const markerSize = isCapital ? "120px" : "100px";
      const borderColor = isCapital ? "#667eea" : "#9f7aea";
      const borderWidth = isCapital ? "3px" : "2px";
      const iconSize = isCapital ? "60px" : "50px";
      const fontSize = isCapital ? "22px" : "18px";

      weatherElement.style.cssText = `
        background: white;
        border-radius: 15px;
        padding: ${isCapital ? "12px 16px" : "10px 12px"};
        box-shadow: 0 4px 20px rgba(0,0,0,0.25);
        display: flex;
        flex-direction: column;
        align-items: center;
        min-width: ${markerSize};
        cursor: pointer;
        transition: transform 0.3s, box-shadow 0.3s;
        border: ${borderWidth} solid ${borderColor};
        ${isCapital ? "box-shadow: 0 4px 25px rgba(102, 126, 234, 0.4);" : ""}
      `;

      weatherElement.innerHTML = `
        <div style="font-weight: bold; font-size: ${
          isCapital ? "14px" : "12px"
        }; margin-bottom: 6px; text-align: center; color: #333;">
          ${isCapital ? "⭐ " : ""}${location.city}
        </div>
        <img src="${
          weather.condition.icon
        }" style="width: ${iconSize}; height: ${iconSize};" alt="${
        weather.condition.text
      }">
        <div style="font-size: ${fontSize}; font-weight: bold; color: ${borderColor}; margin-top: 4px;">${
        weather.temp_c
      }°C</div>
        <div style="font-size: 11px; color: #666; margin-top: 2px;">${
          weather.condition.text
        }</div>
      `;

      weatherElement.addEventListener("mouseenter", () => {
        weatherElement.style.transform = "scale(1.15)";
        weatherElement.style.boxShadow = "0 8px 30px rgba(102, 126, 234, 0.4)";
      });

      weatherElement.addEventListener("mouseleave", () => {
        weatherElement.style.transform = "scale(1)";
        weatherElement.style.boxShadow = "0 4px 20px rgba(0,0,0,0.25)";
      });

      // Create detailed popup
      const popupHTML = `
        <div style="font-family: Arial, sans-serif; min-width: 250px; padding: 10px;">
          <div style="text-align: center; margin-bottom: 15px;">
            <strong style="font-size: 20px; color: #667eea;">${location.city}, ${location.country}</strong>
          </div>
          <div style="display: flex; align-items: center; gap: 15px; margin: 15px 0; justify-content: center; background: #f8f9fa; padding: 15px; border-radius: 10px;">
            <img src="${weather.condition.icon}" style="width: 70px; height: 70px;" alt="${weather.condition.text}">
            <div>
              <div style="font-size: 32px; font-weight: bold; color: #667eea;">${weather.temp_c}°C</div>
              <div style="font-size: 14px; color: #666; margin-top: 4px;">${weather.condition.text}</div>
            </div>
          </div>
          <div style="font-size: 13px; line-height: 2; background: white; padding: 12px; border-radius: 8px; border: 1px solid #e0e0e0;">
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
              <div style="display: flex; align-items: center; gap: 6px;">
                <span style="font-size: 16px;">💨</span>
                <span>Wind: <strong>${weather.wind_kph} km/h</strong></span>
              </div>
              <div style="display: flex; align-items: center; gap: 6px;">
                <span style="font-size: 16px;">💧</span>
                <span>Humidity: <strong>${weather.humidity}%</strong></span>
              </div>
              <div style="display: flex; align-items: center; gap: 6px;">
                <span style="font-size: 16px;">👁️</span>
                <span>Visibility: <strong>${weather.vis_km} km</strong></span>
              </div>
              <div style="display: flex; align-items: center; gap: 6px;">
                <span style="font-size: 16px;">🌡️</span>
                <span>Feels: <strong>${weather.feelslike_c}°C</strong></span>
              </div>
            </div>
          </div>
          <button onclick="showDetailedForecast('${location.city}')" 
                  style="margin-top: 15px; padding: 10px 16px; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; border: none; border-radius: 8px; cursor: pointer; width: 100%; font-size: 14px; font-weight: bold; transition: transform 0.2s;">
            📅 View 3-Day Forecast
          </button>
        </div>
      `;

      // Create marker
      const marker = new mapboxgl.Marker({ element: weatherElement })
        .setLngLat([location.lon, location.lat])
        .setPopup(
          new mapboxgl.Popup({
            offset: 35,
            maxWidth: "350px",
          }).setHTML(popupHTML)
        )
        .addTo(weatherMap);

      weatherMarkers.push(marker);
      bounds.extend([location.lon, location.lat]);
    });

    // Fit map to show all markers with nice padding
    weatherMap.fitBounds(bounds, { padding: 100 });
  }

  // Show detailed forecast
  async function showDetailedForecast(city) {
    try {
      const apiKey = "520a2f952b9a44fdb27111656251412";
      const response = await fetch(
        `https://api.weatherapi.com/v1/forecast.json?key=${apiKey}&q=${encodeURIComponent(
          city
        )}&days=3&aqi=no`
      );

      if (!response.ok) {
        throw new Error("Forecast data not available");
      }

      const data = await response.json();

      let forecastHTML = `📅 3-DAY FORECAST\n`;
      forecastHTML += `${data.location.name}, ${data.location.country}\n`;
      forecastHTML += `${"=".repeat(50)}\n\n`;

      data.forecast.forecastday.forEach((day, index) => {
        const date = new Date(day.date).toLocaleDateString("en-US", {
          weekday: "long",
          month: "long",
          day: "numeric",
        });

        forecastHTML += `${
          index === 0 ? "📍 TODAY" : index === 1 ? "📍 TOMORROW" : "📍 DAY 3"
        } - ${date}\n`;
        forecastHTML += `${"─".repeat(50)}\n`;
        forecastHTML += `🌡️  Temperature: ${day.day.mintemp_c}°C - ${day.day.maxtemp_c}°C\n`;
        forecastHTML += `☁️  Condition: ${day.day.condition.text}\n`;
        forecastHTML += `💧 Rain Chance: ${day.day.daily_chance_of_rain}%\n`;
        forecastHTML += `💨 Max Wind: ${day.day.maxwind_kph} km/h\n`;
        forecastHTML += `👁️  Avg Visibility: ${day.day.avgvis_km} km\n`;
        forecastHTML += `💧 Avg Humidity: ${day.day.avghumidity}%\n\n`;
      });

      alert(forecastHTML);
    } catch (error) {
      console.error("Forecast fetch error:", error);
      alert("Unable to fetch weather forecast. Please try again.");
    }
  }

  // Refresh weather data
  document.getElementById("refresh-weather").addEventListener("click", () => {
    loadWeatherData();
  });

  // Initialize map when page loads
  document.addEventListener("DOMContentLoaded", function () {
    initWeatherMap();
  });
</script>
