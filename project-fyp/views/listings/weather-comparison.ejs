    // Check and remove wind layer if exists
    if (weatherMap.getLayer("wind-layer")) {
      weatherMap.removeLayer("wind-layer");
      weatherMap.removeSource("wind-tiles");
    }
    if (weatherMap.getLayer("wind-background")) {
      weatherMap.removeLayer("wind-background");
      weatherMap.removeSource("wind-background-source");
    }

    // Add a semi-transparent white background for wind layer to make arrows more visible
