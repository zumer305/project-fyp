<% layout("/layouts/boiler")%>
<%=success%>
<body>
  <h3>All listings</h3>
  <!-- <form method="GET" action="/listings/new" >
        <button>Create New listings</button>
    </form> -->

    <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1">
 <%for(let listing of allListings){%>
    <a href="/listings/<%=listing._id%>" class="listing-link">
  <div class="card col listing-card" >
    <img src="<%=listing.image.url%>" class="card-img-top" alt="listing-image"  style="height: 20rem"/>

      <div class="card-img-overlay"></div>


    <div class="card-body">
      <p class="card-text">
      <b> <%=listing.title%> </b><br>
  <span class="price-display" data-price="<%= listing.price %>" data-currency="PKR"></span> /night<br>
      <small class="text-muted">
        <i class="bi bi-clock"></i> 
        <span class="local-time" data-location="<%= listing.location || listing.country %>">--:--</span>
      </small>
      </p>
    </div>
  </div>
  <%}%>
  

    </div>

  <script>
    // Initialize prices on page load
    document.addEventListener('DOMContentLoaded', async function() {
      await updateAllPrices();
    });

    // Handle currency changes
    document.addEventListener('currencyChanged', async (e) => {
      await updateAllPrices();
    });

    async function updateAllPrices() {
      const currentCurrency = CurrencyConverter.getUserCurrency();
      const priceElements = document.querySelectorAll('[data-price]');
      
      if (priceElements.length === 0) return;
      
      // Group elements by their source currency
      const currencyGroups = {};
      priceElements.forEach(element => {
        const fromCurrency = element.getAttribute('data-currency') || 'USD';
        if (!currencyGroups[fromCurrency]) {
          currencyGroups[fromCurrency] = [];
        }
        currencyGroups[fromCurrency].push(element);
      });
      
      // Fetch exchange rate ONCE per currency pair
      for (const fromCurrency in currencyGroups) {
        const elements = currencyGroups[fromCurrency];
        
        if (currentCurrency === fromCurrency) {
          // Same currency - no conversion needed
          const currencySymbol = CurrencyConverter.getSymbol(fromCurrency);
          elements.forEach(element => {
            const originalPrice = parseFloat(element.getAttribute('data-price'));
            if (!isNaN(originalPrice)) {
              element.textContent = `${fromCurrency} ${originalPrice.toLocaleString()}`;
            }
          });
        } else {
          // Get rate ONCE for this currency pair
          const rateResult = await CurrencyConverter.getExchangeRate(fromCurrency, currentCurrency);
          
          if (rateResult.success) {
            const rate = rateResult.rate;
            
            // Apply rate to ALL elements with this currency
            elements.forEach(element => {
              const originalPrice = parseFloat(element.getAttribute('data-price'));
              if (!isNaN(originalPrice)) {
                const convertedAmount = CurrencyConverter.convertWithRate(originalPrice, rate);
                element.textContent = CurrencyConverter.formatCurrency(convertedAmount, currentCurrency);
              }
            });
          }
        }
      }
    }
  </script>

  <script>
    // Load local times for all listings
    document.addEventListener('DOMContentLoaded', async function() {
      if (typeof WorldTime === 'undefined') return;

      const timeElements = document.querySelectorAll('.local-time');
      
      // Keep track of locations we've already fetched to avoid duplicate API calls
      const locationCache = new Map();

      for (const element of timeElements) {
        const location = element.getAttribute('data-location');
        if (!location) continue;

        // Check if we already fetched this location
        if (locationCache.has(location)) {
          const cachedData = locationCache.get(location);
          element.textContent = cachedData.time;
          element.title = cachedData.title;
          continue;
        }

        // Fetch time for this location
        const result = await WorldTime.getLocalTime(location);
        
        if (result.success) {
          const { hour, minute, timezone } = result.data;
          const formattedTime = WorldTime.formatTime12Hour(hour, minute);
          const title = timezone ? `${timezone}` : 'Local time';
          
          // Cache it
          locationCache.set(location, { time: formattedTime, title: title });
          
          // Update element
          element.textContent = formattedTime;
          element.title = title;
        } else {
          element.textContent = 'N/A';
          element.title = 'Time not available';
        }
      }
    });
  </script>
 
</body>
