    updateBudgetLabel();

    // Handle currency changes for package prices
    document.addEventListener("currencyChanged", async (e) => {
      const newCurrency = e.detail.currency;
      updateBudgetLabel(); // Update the budget label
      await updatePackagePrices(newCurrency);
    });

    // Function to update package prices
    async function updatePackagePrices(currency) {
      const priceElements = document.querySelectorAll("[data-price]");

      for (const element of priceElements) {
        const originalPrice = parseFloat(element.getAttribute("data-price"));
        const fromCurrency = element.getAttribute("data-currency") || "USD";

        if (!isNaN(originalPrice)) {
          if (currency === fromCurrency) {
            // Reset to original
            element.textContent = `$${originalPrice.toLocaleString()}`;
          } else {
            const result = await CurrencyConverter.convert(
              originalPrice,
              fromCurrency,
              currency
            );
            if (result.success) {
              element.textContent = CurrencyConverter.formatCurrency(
                result.result,
                currency
              );
            }
          }
        }
      }
    }
