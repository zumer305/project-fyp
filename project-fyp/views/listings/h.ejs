    // Mapbox Directions function
    async function getDirectionsTo(destLat, destLon, destName) {
      try {
        // Get user's current location
        const position = await new Promise((resolve, reject) => {
          navigator.geolocation.getCurrentPosition(resolve, reject);
        });

        const userLon = position.coords.longitude;
        const userLat = position.coords.latitude;

        const map = window.__mapbox_map;

        // Mapbox Directions API
        const accessToken =
          "pk.eyJ1IjoienVtZXIiLCJhIjoiY21pdWVvNnp4MGI4cjNnczhyNHdjYWJwZyJ9.bUa1KnOak9YFcggGRw4-2w";
        const url = `https://api.mapbox.com/directions/v5/mapbox/driving/${userLon},${userLat};${destLon},${destLat}?geometries=geojson&access_token=${accessToken}`;

        const response = await fetch(url);
        const data = await response.json();

        if (data.routes && data.routes.length > 0) {
          const route = data.routes[0];
          const distance = (route.distance / 1000).toFixed(2); // Convert to km
          const duration = Math.round(route.duration / 60); // Convert to minutes

          // Remove existing route if any
          if (map.getSource("route")) {
            map.removeLayer("route");
            map.removeSource("route");
          }

          // Add route line to map
          map.addSource("route", {
            type: "geojson",
            data: {
              type: "Feature",
              properties: {},
              geometry: route.geometry,
            },
          });

          map.addLayer({
            id: "route",
            type: "line",
            source: "route",
            layout: {
              "line-join": "round",
              "line-cap": "round",
            },
            paint: {
              "line-color": "#007acc",
              "line-width": 5,
              "line-opacity": 0.75,
            },
          });

          // Add user location marker
          if (window.__user_marker) {
            window.__user_marker.remove();
          }
          window.__user_marker = new mapboxgl.Marker({ color: "#22c55e" })
            .setLngLat([userLon, userLat])
            .setPopup(
              new mapboxgl.Popup().setHTML("<strong>Your Location</strong>")
            )
            .addTo(map);

          // Fit map to show entire route
          const coordinates = route.geometry.coordinates;
          const bounds = coordinates.reduce((bounds, coord) => {
            return bounds.extend(coord);
          }, new mapboxgl.LngLatBounds(coordinates[0], coordinates[0]));

          map.fitBounds(bounds, { padding: 50 });

          alert(
            `Route to ${destName}\n\nDistance: ${distance} km\nEstimated time: ${duration} minutes`
          );
        } else {
          alert("Could not find a route to this location");
        }
      } catch (error) {
        console.error("Directions error:", error);
        if (error.code === 1) {
          alert("Please enable location access to get directions");
        } else {
          alert("Failed to get directions. Please try again.");
        }
      }
    }

    async function geocodeAreaNominatim(area) {
      try {
        const url = `https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(
          area
        )}&limit=1`;
        const res = await fetch(url, { headers: { "Accept-Language": "en" } });
        if (!res.ok) throw new Error("Geocode failed");
        const data = await res.json();
        if (data && data[0])
          return { lat: Number(data[0].lat), lon: Number(data[0].lon) };
      } catch (e) {
        console.warn("Nominatim geocode failed", e);
      }
      return null;
    }

    // Helper function to calculate distance between two coordinates (Haversine formula)
    function calculateDistance(lat1, lon1, lat2, lon2) {
      const R = 6371; // Earth's radius in kilometers
      const dLat = ((lat2 - lat1) * Math.PI) / 180;
      const dLon = ((lon2 - lon1) * Math.PI) / 180;
      const a =
        Math.sin(dLat / 2) * Math.sin(dLat / 2) +
        Math.cos((lat1 * Math.PI) / 180) *
          Math.cos((lat2 * Math.PI) / 180) *
          Math.sin(dLon / 2) *
          Math.sin(dLon / 2);
      const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
      return R * c;
    }

    async function renderMapboxMarkers(items, center) {
      if (!items || !items.length) {
        alert(
          "No places found for this destination. Try a different city or country."
        );
        return;
      }

      try {
        console.log("Rendering", items.length, "items on Mapbox map");

        // Ensure map is initialized
        initMapboxMap();
        const map = window.__mapbox_map;

        // Determine center: prefer provided lat/lon, else fallback
        let mapCenter = { lat: 42.8746, lon: 74.5698 };
        if (center && center.lat && center.lon) {
          mapCenter = { lat: Number(center.lat), lon: Number(center.lon) };
        }

        console.log("Map center:", mapCenter);
        updateMapAreaLabel(center && center.area);

        // Clear old markers
        if (window.__mapbox_markers) {
          window.__mapbox_markers.forEach((m) => m.remove());
        }
        window.__mapbox_markers = [];

        // Process all items
        const processedItems = items
          .map((it) => {
            let lat, lon;

            if (it.lat != null && it.lon != null) {
              lat = Number(it.lat);
              lon = Number(it.lon);
            } else {
              console.warn("Item missing coordinates:", it.name);
              return null;
            }

            const distance = calculateDistance(
              mapCenter.lat,
              mapCenter.lon,
              lat,
              lon
            );

            return {
              name: it.name,
              note: it.note || "",
              lat,
              lon,
              distance: distance.toFixed(1),
            };
          })
          .filter(Boolean);

        if (processedItems.length === 0) {
          alert(
            "No valid location data found. The destination may not have mapped mosques/restaurants."
          );
          return;
        }

        // Sort items by distance
        processedItems.sort(
          (a, b) => parseFloat(a.distance) - parseFloat(b.distance)
        );

        console.log("Processed items:", processedItems.length);

        // Add new Mapbox markers
        const markers = [];
        const bounds = new mapboxgl.LngLatBounds();

        processedItems.forEach((it, index) => {
          // Create popup content with directions button
          const popupHTML = `
            <div style="font-family: Arial, sans-serif;">
              <strong style="font-size: 14px;">${it.name}</strong>
              <div style="font-size: 12px; margin-top: 4px;">${it.note}</div>
              <div style="margin-top: 6px; font-weight: bold; font-size: 12px;">📍 ${
                it.distance
              } km from center</div>
              <button onclick="getDirectionsTo(${it.lat}, ${
            it.lon
          }, '${it.name.replace(/'/g, "\\'")}')" 
                      style="margin-top: 8px; padding: 6px 12px; background: #007acc; color: white; border: none; border-radius: 4px; cursor: pointer; width: 100%; font-size: 12px;">
                🚗 Get Directions
              </button>
            </div>
          `;

          // Create marker
          const marker = new mapboxgl.Marker({ color: "#007acc" })
            .setLngLat([it.lon, it.lat])
            .setPopup(new mapboxgl.Popup({ offset: 25 }).setHTML(popupHTML))
            .addTo(map);

          markers.push(marker);
          bounds.extend([it.lon, it.lat]);

          // Open first marker popup automatically
          if (index === 0) {
            marker.togglePopup();
          }
        });

        window.__mapbox_markers = markers;

        // Fit map to show all markers
        if (markers.length > 1) {
          map.fitBounds(bounds, { padding: 50 });
        } else if (markers.length === 1) {
          map.flyTo({
            center: [processedItems[0].lon, processedItems[0].lat],
            zoom: 14,
          });
        }

        console.log(
          `Successfully rendered ${markers.length} markers on Mapbox map`
        );
      } catch (e) {
        console.error("Map rendering failed:", e);
        const list = items
          .map((i) => `- ${i.name}${i.note ? " — " + i.note : ""}`)
          .join("\n");
        alert(
          "Found places:\n" +
            list +
            "\n\n(Map rendering failed - check console)"
        );
      }
    }

