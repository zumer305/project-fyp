    );

    // If a package is cached, replace the hard-coded AI card with its details
    (async function populateAICardFromCache() {
      try {
        const raw = localStorage.getItem("selectedPackage");
        const card = document.querySelector(".grid .card");
        const heading = document.getElementById("package-heading");
        if (!card) return;

        let pkg = null;
        let usedRecommendation = false;

        // Check if user has selected a package
        if (raw) {
          try {
            pkg = JSON.parse(raw);
          } catch (e) {
            pkg = null;
          }
        }

        // Update heading based on whether package is selected or recommended
        if (raw && pkg) {
          // User has selected a package
          if (heading) {
            heading.textContent = "🧠 My Selected Package";
          }
        } else {
          // No package selected - show recommendations
          if (heading) {
            heading.textContent = "✨ Recommendations for You";
          }

          // fetch random destination from server
          try {
            const countryInput =
              (document.getElementById("country") &&
                document.getElementById("country").value) ||
              "";
            const budgetInput =
              (document.getElementById("budget") &&
                document.getElementById("budget").value) ||
              "";
            const q = `?country=${encodeURIComponent(
              countryInput
            )}&budget=${encodeURIComponent(budgetInput)}`;
            const res = await fetch("/api/packages" + q);
            if (res.ok) {
              const data = await res.json();
              const items = data.items || [];
              if (items.length > 0) {
                pkg = items[Math.floor(Math.random() * items.length)];
                usedRecommendation = true;
              }
            }
          } catch (e) {
            // fallback: leave pkg null
            console.warn(
              "Failed to fetch package recommendations from server",
              e
            );
          }
        }

        if (!pkg) return; // nothing to show

        // Add a small badge indicating this is a recommendation when using server-provided item
        const header = card.querySelector("h3");
        if (usedRecommendation && header) {
          const badge = document.createElement("div");
          badge.textContent = "Recommendation for you";
          badge.style.fontSize = "0.85rem";
          badge.style.color = "#0f8e95";
          badge.style.fontWeight = "700";
          badge.style.marginBottom = "6px";
          header.parentNode.insertBefore(badge, header);
        }

        // Update image if present
        const img = card.querySelector("img");
        if (img && pkg.image) img.src = pkg.image;
        else if (img && pkg.images && pkg.images.length)
          img.src = pkg.images[0];

        // Update title
        const titleEl = card.querySelector("h3");
        if (titleEl && pkg.name) titleEl.textContent = pkg.name;

        // Update price paragraph (first <p> after title)
        const pEls = card.querySelectorAll("p");
        if (pEls && pEls.length > 0) {
          const priceEl = pEls[0];
          if (pkg.minBudget || pkg.maxBudget) {
            const priceText =
              pkg.minBudget && pkg.maxBudget
                ? `${pkg.minBudget}-${pkg.maxBudget}`
                : pkg.minBudget || pkg.maxBudget || "N/A";
            priceEl.textContent = `💰 $${priceText} / trip`;
          } else if (pkg.price) {
            priceEl.textContent = `💰 $${Number(
              pkg.price
            ).toLocaleString()} / trip`;
          }
          if (pEls[1])
            pEls[1].textContent = pkg.description
              ? pkg.description.substring(0, 80) + "..."
              : pkg.country
              ? pkg.country
              : "";
        }

        // Update tags to show duration and first attractions
        const tags = card.querySelector(".tags");
        if (tags) {
          tags.innerHTML = "";
          if (pkg.duration) {
            const s = document.createElement("span");
            s.textContent = `#${pkg.duration}`;
            tags.appendChild(s);
          } else if (pkg.typicalDuration) {
            const s = document.createElement("span");
            s.textContent = `#${pkg.typicalDuration}d`;
            tags.appendChild(s);
          }
          if (pkg.attractions && pkg.attractions.length) {
            pkg.attractions.slice(0, 3).forEach((t) => {
              const s = document.createElement("span");
              s.textContent = `#${t.replace(/\s+/g, "")}`;
              tags.appendChild(s);
            });
          }
        }

        // Attach recommendation data to View button when not using a real cached package
        const viewBtn = card.querySelector(".view");
        if (viewBtn) {
          if (usedRecommendation) {
            // store the full package object returned by generatePackages so detail page can render it
            viewBtn.dataset.recommendation = encodeURIComponent(
              JSON.stringify(pkg)
            );
          } else {
            delete viewBtn.dataset.recommendation;
          }
        }
      } catch (e) {
        console.warn(
          "Could not populate AI card from cached package or server recommendations",
          e
        );
      }
    })();

    // Ensure map redraw on window resize or when page becomes visible again (fixes tiles in some layouts)
    (function () {
      let __leaflet_invalidate_timer = null;
      window.addEventListener("resize", () => {
        if (__leaflet_invalidate_timer)
          clearTimeout(__leaflet_invalidate_timer);
        __leaflet_invalidate_timer = setTimeout(() => {
          try {
            if (window.__leaflet_map) {
              window.__leaflet_map.invalidateSize();
              if (
                window.__leaflet_tileLayer &&
                window.__leaflet_tileLayer.redraw
              )
                window.__leaflet_tileLayer.redraw();
            }
          } catch (e) {
            console.warn("Leaflet invalidate on resize failed", e);
          }
        }, 200);
      });

      document.addEventListener("visibilitychange", () => {
        if (document.visibilityState === "visible") {
          setTimeout(() => {
            try {
              if (window.__leaflet_map) {
                window.__leaflet_map.invalidateSize();
                if (
                  window.__leaflet_tileLayer &&
                  window.__leaflet_tileLayer.redraw
                )
                  window.__leaflet_tileLayer.redraw();
              }
            } catch (e) {
              console.warn("Leaflet invalidate on visibilitychange failed", e);
            }
          }, 150);
        }
      });
    })();

    // Update budget label with selected currency
    const updateBudgetLabel = () => {
      const selectedCurrency = CurrencyConverter.getUserCurrency();
      const budgetLabel = document.getElementById("budget-currency");
      if (budgetLabel) {
        budgetLabel.textContent = selectedCurrency;
      }
    };

