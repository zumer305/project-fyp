<% layout("/layouts/boiler")%>
<style>
  .travel-box {
    width: 300px;
    margin: 20px auto;
    padding: 20px;
    border-radius: 10px;
    background: #e0f0ff; /* light blue theme */
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    font-family: Arial, sans-serif;
  }
  .travel-box button {
    margin-top: 15px;
    width: 100%;
    padding: 10px;
    background-color: #007acc;
    color: white;
    border: none;
    border-radius: 5px;
    cursor: pointer;
  }
  .travel-box button:hover {
    background-color: #005f99;
  }
  .result {
    margin-top: 10px;
    font-weight: bold;
    color: #005f99;
    text-align: center;
  }
  .map-area-badge {
    position: absolute;
    top: 16px;
    left: 18px;
    background: rgba(0, 0, 0, 0.65);
    color: #fff;
    padding: 6px 12px;
    border-radius: 999px;
    font-size: 0.9rem;
    letter-spacing: 0.02em;
    z-index: 550;
    pointer-events: none;
  }

  .bookings-card {
    max-width: 960px;
    margin: 0 auto 28px;
    padding: 22px 26px;
    border-radius: 16px;
    background: linear-gradient(120deg, #f8fbff, #eef4ff);
    border: 1px solid #dfe7fb;
    box-shadow: 0 14px 35px rgba(0, 28, 80, 0.08);
    display: flex;
    align-items: center;
    gap: 18px;
  }

  .bookings-card .icon-pill {
    width: 54px;
    height: 54px;
    border-radius: 14px;
    background: linear-gradient(135deg, #2f80ed, #56ccf2);
    display: grid;
    place-items: center;
    color: #fff;
    font-size: 1.5rem;
    box-shadow: 0 10px 25px rgba(47, 128, 237, 0.25);
  }

  .bookings-card h3 {
    margin: 0 0 6px;
    font-size: 1.35rem;
    color: #1c2a4a;
  }

  .bookings-card p {
    margin: 0;
    color: #4a5674;
    font-size: 0.98rem;
  }

  .bookings-card .actions {
    margin-left: auto;
  }

  .bookings-card .cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 18px;
    background: #1f6feb;
    color: #fff;
    border-radius: 10px;
    text-decoration: none;
    font-weight: 700;
    box-shadow: 0 10px 25px rgba(31, 111, 235, 0.28);
    transition: transform 0.15s ease, box-shadow 0.15s ease, background 0.15s ease;
  }

  .bookings-card .cta-btn:hover {
    background: #195ac4;
    transform: translateY(-2px);
    box-shadow: 0 14px 32px rgba(31, 111, 235, 0.32);
  }

  .location-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 12px;
    border-radius: 999px;
    background: #eef3ff;
    color: #1f6feb;
    font-weight: 700;
    font-size: 0.95rem;
    border: 1px solid #dfe7fb;
    box-shadow: 0 8px 18px rgba(0, 28, 80, 0.08);
  }
</style>

<!-- Mapbox GL JS CSS moved to global layout for consistency (see layouts/boiler.ejs) -->

<body data-logged-in="<%= !!currUser %>">
  <div class="travel-box">
    <h3>🌍 Travel Budget</h3>

    <label for="country">Select Central Asian Country:</label>
    <select id="country">
      <option value="">-- Choose Country --</option>
      <option value="Azerbaijan">Azerbaijan</option>
      <option value="Kazakhstan">Kazakhstan</option>
      <option value="Kyrgyzstan">Kyrgyzstan</option>
      <option value="Tajikistan">Tajikistan</option>
      <option value="Turkmenistan">Turkmenistan</option>
      <option value="Uzbekistan">Uzbekistan</option>
    </select>

    <label for="budget">
      Enter Budget (<span id="budget-currency" class="currency-label"></span>):
    </label>
    <input
      type="number"
      id="budget"
      placeholder="e.g. 10000"
      oninput="showBudget()"
    />

    <div class="result" id="result"></div>

    <!-- Button to go to packages page -->
    <button onclick="goToPackages()">View Packages</button>
  </div>

  <h2 id="package-heading">🧠 My Bookings</h2>
  <div class="grid">
    <div class="bookings-card">
      <div class="icon-pill">📄</div>
      <div>
        <h3>Access Your Bookings</h3>
        <p>Open your booking details and confirmations in one place.</p>
      </div>
      <div class="actions">
        <a class="cta-btn" href="/bookings/my-bookings">Open My Bookings →</a>
      </div>
    </div>
  </div>

  <div class="section">
    <h2>👥 Travel Manager</h2>
    <div class="grid">
      <div class="feature-card">
        <div class="icon-title">
          <img
            src="https://img.icons8.com/ios-filled/50/add-user-group-man-man.png"
          />
          <h3>Group Travel Planner</h3>
        </div>
        <p>
          Create groups, invite friends, chat in real-time, and plan your trips
          together. Manage all your group travel activities in one place.
        </p>
        <button
          id="btn-group-travel"
        >
          🎯 Manage Groups
        </button>
      </div>
      <div class="feature-card">
        <div class="icon-title">
          <img src="https://img.icons8.com/ios-glyphs/30/money.png" />
          <h3>Expense Details</h3>
        </div>
        <p>Track spending and calculate balances between members.</p>
        <button id="btn-expense-summary">💸 View Summary</button>
      </div>
    </div>
  </div>

  <% const latestCity = latestBooking && (latestBooking.packageDetails.destination || latestBooking.packageDetails.city); %>
  <% const latestCountry = latestBooking && (latestBooking.packageDetails.country || latestBooking.packageDetails.destination); %>
  <% const latestLocation = [latestCity, latestCountry].filter(Boolean).join(', '); %>

  <div class="section">
    <div style="display:flex;align-items:center;gap:12px;flex-wrap:wrap;">
      <h2 style="margin:0;">🕌 Faith-Friendly Travel Tools</h2>
      <span class="location-pill">
        📍 <%= latestLocation || 'Set a booking to personalize location' %>
      </span>
    </div>
    <div class="grid">
      <div class="feature-card">
        <div class="icon-title">
          <img src="https://img.icons8.com/ios-filled/50/mosque.png" />
          <h3>Nearby Mosques</h3>
        </div>
        <p>Find mosques near <%= latestLocation || 'your destination' %> with prayer times and distance info.</p>
        <button id="btn-find-mosques">🕌 Find Mosques</button>
      </div>
      <div class="feature-card">
        <div class="icon-title">
          <img src="https://img.icons8.com/ios-filled/50/compass.png" />
          <h3>Qiblah Direction</h3>
        </div>
        <p>View direction of Qiblah from  your location.</p>
        <button id="btn-show-qiblah">🕋 Show Qiblah</button>
      </div>
      <div class="feature-card">
        <div class="icon-title">
          <img src="https://img.icons8.com/ios-filled/50/restaurant.png" />
          <h3>Halal Food Locator</h3>
        </div>
        <p>Discover halal restaurants in <%= latestLocation || 'your area' %>.</p>
        <button id="btn-find-halal">🍽️ Find Halal</button>
      </div>
      <div class="feature-card">
        <div class="icon-title">
          <img src="https://img.icons8.com/ios-filled/50/bed.png" />
          <h3>Hotel Finder</h3>
        </div>
        <p>Find hotels and guest houses in <%= latestLocation || 'your destination' %>.</p>
        <button id="btn-find-hotels">🏨 Find Hotels</button>
      </div>
    </div>
  </div>
  <!-- 📍 Map Section -->
  <div class="section">
    <h2>Explore on Map</h2>
    <div class="map">
      <!-- Interactive map: will load Mapbox GL dynamically -->
      <div
        id="map"
        style="
          width: 100%;
          height: 420px;
          border-radius: 8px;
          overflow: hidden;
          background: #e9eef3;
          display: block;
          position: relative;
          min-height: 200px;
        "
      ></div>
      <div
        id="map-area-badge"
        class="map-area-badge"
        style="display: none"
      ></div>
    </div>
  </div>

  <!-- 📡 Scraped Info Section -->
  <div class="section">
    <div style="display:flex;align-items:center;gap:12px;flex-wrap:wrap;margin-bottom:20px;">
      <h2 style="margin:0;">Live Destination Insights</h2>
      <% if (latestLocation) { %>
        <span class="location-pill">
          📍 <%= latestLocation %>
        </span>
      <% } %>
    </div>
    <div class="cards">
      <div class="insight-card">
        <div class="insight-card-icon">💸</div>
        <h3>Local Taxi Fares</h3>
        <% if (latestCountry) { %>
          <p class="insight-location"><%= latestCountry %></p>
          <p class="taxi-fare-text">
            Base fare starts at <span data-price="334.20" data-currency="PKR" class="inline-price"></span> with <span data-price="139.25" data-currency="PKR" class="inline-price"></span>/km. Rideshare apps available.
          </p>
        <% } else { %>
          <p class="taxi-fare-text">
            View real-time taxi fares for Central Asian destinations.
          </p>
        <% } %>
        <a class="insight-btn" href="/fares" onclick="saveFaresContext()">
          <span>View More</span>
          <i class="fas fa-arrow-right"></i>
        </a>
        <div class="updated-note">Updated automatically</div>
      </div>
      <div class="insight-card">
        <div class="insight-card-icon">📅</div>
        <h3>Festivals & Events</h3>
        <% if (latestCity || latestCountry) { %>
          <p class="insight-location"><%= latestCity || latestCountry %></p>
          <p>
            Discover local festivals like Nowruz, cultural celebrations, and seasonal events happening in your destination.
          </p>
        <% } else { %>
          <p>
            Explore cultural festivals and events across Central Asia.
          </p>
        <% } %>
        <a class="insight-btn" href="/listings/eventbrite">
          <span>View More</span>
          <i class="fas fa-arrow-right"></i>
        </a>
        <div class="updated-note">Updated automatically</div>
      </div>
      <div class="insight-card">
        <div class="insight-card-icon">🌤️</div>
        <h3>Weather Comparison</h3>
        <% if (latestCity || latestCountry) { %>
          <p class="insight-location"><%= latestCity || latestCountry %></p>
        <% } %>
        <div id="weather-info">
          <p style="margin-bottom: 14px;color:#4a5674;">
            Compare weather across all Central Asian countries on an interactive map.
          </p>
          <button
            onclick="window.location.href='/listings/weather-comparison'"
            class="weather-map-btn"
          >
            🗺️ Open Weather Map
          </button>
        </div>
        <a class="insight-btn" href="/listings/weather-comparison">
          <span>View Full Screen</span>
          <i class="fas fa-arrow-right"></i>
        </a>
        <div class="updated-note">Live weather data</div>
      </div>
    </div>
  </div>

  <!-- <button onclick="goToPackages()">View Packages</button> -->

  <script>
    const isLoggedIn = document.body.dataset.loggedIn === "true";
    // Country-specific budget thresholds (PKR) derived from CSV packages
    const COUNTRY_BUDGET_THRESHOLDS = {
      Azerbaijan: { basic: 167000, mid: 288000, luxury: 590000 },
      Kazakhstan: { basic: 152000, mid: 288000, luxury: 805000 },
      Kyrgyzstan: { basic: 136000, mid: 259000, luxury: 710000 },
      Tajikistan: { basic: 141000, mid: 275000, luxury: 785000 },
      Turkmenistan: { basic: 306000, mid: 580000, luxury: 1150000 },
      Uzbekistan: { basic: 112000, mid: 240000, luxury: 680000 },
    };

    let cachedRate = null; // Cache the rate globally for this page (kept for future currency use)
    let cachedCurrency = null;

    function getThresholdsPKR(country) {
      return COUNTRY_BUDGET_THRESHOLDS[country] || {
        basic: 112000,
        mid: 240000,
        luxury: 680000,
      };
    }

    function showBudget() {
      const budget = document.getElementById("budget").value;
      const country = document.getElementById("country").value;
      const result = document.getElementById("result");
      const { basic, mid, luxury } = getThresholdsPKR(country);
      const budgetNum = parseFloat(budget);

      if (!budget) {
        result.innerHTML = "";
        return;
      }

      if (budgetNum < basic) {
        result.innerHTML = `<span style="color: #dc3545;">💰 Budget: Rs${budgetNum.toLocaleString()} - Consider increasing for better packages (min ~Rs${basic.toLocaleString()})</span>`;
      } else if (budgetNum >= basic && budgetNum < mid) {
        result.innerHTML = `<span style="color: #ffc107;">💰 Budget: Rs${budgetNum.toLocaleString()} - Good for basic packages (mid-tier starts ~Rs${mid.toLocaleString()})</span>`;
      } else if (budgetNum >= mid && budgetNum < luxury) {
        result.innerHTML = `<span style="color: #28a745;">💰 Budget: Rs${budgetNum.toLocaleString()} - Great for premium packages (luxury starts ~Rs${luxury.toLocaleString()})</span>`;
      } else {
        result.innerHTML = `<span style="color: #28a745;">💰 Budget: Rs${budgetNum.toLocaleString()} - Luxury packages available!</span>`;
      }
    }

    function goToPackages() {
      const country = document.getElementById("country").value;
      const budget = document.getElementById("budget").value;
      const currency = CurrencyConverter.getUserCurrency();

      if (country && budget) {
        window.location.href = `/packages?country=${encodeURIComponent(
          country
        )}&budget=${budget}&currency=${currency}`;
      } else {
        alert("Please select a country and enter your budget first!");
      }
    }

    // Update currency label and reset cache when currency changes
    document.addEventListener("DOMContentLoaded", function () {
      updateCurrencyLabels();
    });

    document.addEventListener("currencyChanged", function () {
      cachedRate = null; // Reset cache on currency change
      cachedCurrency = null;
      updateCurrencyLabels();
      // Note: Price conversion is handled by global layout (boiler.ejs)
    });

    function updateCurrencyLabels() {
      const currentCurrency = CurrencyConverter.getUserCurrency();
      const labels = document.querySelectorAll(".currency-label");
      labels.forEach((label) => {
        label.textContent = currentCurrency;
      });
    }

    function saveFaresContext() {
      // Save destination information to localStorage for the fares page
      const country =
        document.getElementById("country").value || "Selected Destination";
      const pkg = getSelectedPackageCached();

      if (pkg && pkg.name) {
        localStorage.setItem("selectedDestination", pkg.name);
      } else if (country) {
        localStorage.setItem("selectedDestination", country);
      } else {
        localStorage.setItem(
          "selectedDestination",
          "Your Selected Destination"
        );
      }

      // Set a default estimated distance (can be updated on the fares page)
      localStorage.setItem("estimatedDistance", "10");
    }

    function saveEventsContext() {
      // Save destination and package information to localStorage for the events page
      const country =
        document.getElementById("country").value || "Selected Destination";
      const pkg = getSelectedPackageCached();

      if (pkg && pkg.name) {
        localStorage.setItem("selectedDestination", pkg.name);
      } else if (country) {
        localStorage.setItem("selectedDestination", country);
      } else {
        localStorage.setItem(
          "selectedDestination",
          "Your Selected Destination"
        );
      }

      // Save the entire package data for events page to access
      if (pkg) {
        localStorage.setItem("selectedPackage", JSON.stringify(pkg));
      }
    }

    // Helpers
    async function getCoords() {
      return new Promise((resolve) => {
        if (!navigator.geolocation) {
          console.log("Geolocation not supported");
          return resolve({ lat: null, lon: null });
        }
        navigator.geolocation.getCurrentPosition(
          (pos) => {
            console.log(
              "Got user location:",
              pos.coords.latitude,
              pos.coords.longitude
            );
            resolve({ lat: pos.coords.latitude, lon: pos.coords.longitude });
          },
          (err) => {
            console.warn("Geolocation denied or failed:", err.message);
            resolve({ lat: null, lon: null });
          },
          { timeout: 10000, enableHighAccuracy: false }
        );
      });
    }

    function normalizePackageDestination(pkg) {
      if (!pkg || typeof pkg !== "object") return null;
      const normalized = { ...pkg };

      if (!normalized.city && normalized.location) {
        normalized.city = normalized.location;
      }

      if (!normalized.country && normalized.region) {
        normalized.country = normalized.region;
      }

      if (!normalized.country) {
        const ctxRaw = localStorage.getItem("selectedPackage_context");
        if (ctxRaw) {
          try {
            const ctx = JSON.parse(ctxRaw);
            if (ctx && ctx.country) {
              normalized.country = ctx.country;
            }
          } catch (e) {
            console.warn("Failed to parse selected package context", e);
          }
        }
      }

      return normalized;
    }

    function hasDestinationInfo(pkg) {
      return !!(pkg && (pkg.city || pkg.country));
    }

    function getSelectedPackageCached() {
      const temp = sessionStorage.getItem("selectedPackage_temp");
      if (temp) {
        try {
          const parsedTemp = normalizePackageDestination(JSON.parse(temp));
          if (parsedTemp && hasDestinationInfo(parsedTemp)) {
            sessionStorage.setItem(
              "selectedPackage_temp",
              JSON.stringify(parsedTemp)
            );
            return parsedTemp;
          }
          sessionStorage.removeItem("selectedPackage_temp");
        } catch (e) {
          console.warn("Failed to parse temporary selected package", e);
        }
      }

      const stored = localStorage.getItem("selectedPackage");
      if (!stored) return null;
      try {
        const parsedStored = normalizePackageDestination(JSON.parse(stored));
        if (parsedStored && hasDestinationInfo(parsedStored)) {
          localStorage.setItem("selectedPackage", JSON.stringify(parsedStored));
          return parsedStored;
        }
        localStorage.removeItem("selectedPackage");
        return null;
      } catch (e) {
        console.warn("Failed to parse stored selected package", e);
        return null;
      }
    }

    function buildFaithQueryParams(pkg) {
      if (!pkg) return "";
      const params = new URLSearchParams();
      if (pkg.city) params.set("city", pkg.city);
      if (pkg.country) params.set("country", pkg.country);
      const str = params.toString();
      return str ? `?${str}` : "";
    }

    function buildMapCenter(data, fallbackArea) {
      const coords = data && data.coords ? data.coords : null;
      const label =
        (data && data.area) || fallbackArea || "Selected Destination";
      if (coords && coords.lat != null && coords.lon != null) {
        return {
          lat: Number(coords.lat),
          lon: Number(coords.lon),
          area: label,
        };
      }
      return label ? { area: label } : null;
    }

    function updateMapAreaLabel(text) {
      const badge = document.getElementById("map-area-badge");
      if (!badge) return;
      if (text) {
        badge.textContent = `📍 ${text}`;
        badge.style.display = "block";
      } else {
        badge.style.display = "none";
      }
    }

    // Wait for DOM to be ready before attaching event listeners
    document.addEventListener("DOMContentLoaded", function () {
      // Group Travel Planner - Redirect to groups page
      document
        .getElementById("btn-group-travel")
        .addEventListener("click", () => {
          if (!isLoggedIn) return (window.location.href = "/login");
          window.location.href = "/groups";
        });

      // Shared Itinerary card removed

      document
        .getElementById("btn-expense-summary")
        .addEventListener("click", () => {
          if (!isLoggedIn) return (window.location.href = "/login");
          window.location.href = "/expenses/latest";
        });

      // Map/Location card removed

      // Faith tools
      document
        .getElementById("btn-find-mosques")
        .addEventListener("click", async () => {
          let destination = null;
          let destinationType = "city"; // or 'country'
          const pkg = getSelectedPackageCached();

          // First priority: Use cached package destination
          if (pkg && (pkg.city || pkg.country)) {
            if (pkg.city) {
              destination = pkg.city;
              destinationType = "city";
            } else {
              destination = pkg.country;
              destinationType = "country";
            }
            console.log(
              `Using cached destination: ${destination} (${destinationType})`
            );
          } else {
            // Fallback: Prompt user
            destination = prompt(
              "Enter destination (city or country name):",
              "Bishkek"
            );
            if (!destination || !destination.trim()) {
              alert("Please enter a destination to search for mosques.");
              return;
            }
            destinationType = "city"; // assume city by default
          }

          const fallbackArea = destination;
          try {
            // Build query with both city and country if available
            let queryParams = new URLSearchParams();
            if (destinationType === "city") {
              queryParams.set("city", destination);
              if (pkg && pkg.country) {
                queryParams.set("country", pkg.country);
              }
            } else {
              queryParams.set("country", destination);
            }

            console.log(`Fetching mosques for: ${queryParams.toString()}`);
            const res = await fetch(
              `/api/faith/mosques?${queryParams.toString()}`
            );
            const data = await res.json();

            console.log("Mosque API response:", data);

            if (!res.ok) {
              alert("Error: " + (data.message || "Failed to find mosques"));
              return;
            }
            if (data.fallback) {
              console.warn("Using fallback data:", data.message);
              alert(
                data.message ||
                  "Using fallback mosque results. Live lookup unavailable."
              );
            }
            const center = buildMapCenter(data, fallbackArea || destination);
            await renderMapboxMarkers(data.items, center);
            updateMapAreaLabel(center && center.area);
          } catch (e) {
            console.error("Failed to load mosques", e);
            alert(
              "Could not load mosques right now. Please check your connection or try again later."
            );
          }
        });

      document
        .getElementById("btn-show-qiblah")
        .addEventListener("click", async () => {
          const c = await getCoords();
          if (!c.lat || !c.lon) {
            alert("Please enable location access to view Qiblah direction");
            return;
          }

          const res = await fetch(
            `/api/faith/qiblah?lat=${c.lat}&lon=${c.lon}`
          );
          const data = await res.json();
          if (res.ok) {
            // Initialize Mapbox map at user location
            initMapboxMap();
            const map = window.__mapbox_map;

            // Center map at user location
            map.flyTo({ center: [c.lon, c.lat], zoom: 15 });

            // Remove existing Qiblah marker if any
            if (window.__qiblah_marker) {
              window.__qiblah_marker.remove();
            }

            // Create a custom Qiblah indicator (arrow pointing to Mecca)
            const qiblahAngle = data.angle; // degrees from north

            // Create a rotated arrow using HTML/CSS as a DOM element
            const qiblahElement = document.createElement("div");
            qiblahElement.innerHTML = `
            <div style="
              width: 50px;
              height: 50px;
              background: radial-gradient(circle, #32CD32 0%, #228B22 100%);
              border-radius: 50%;
              display: flex;
              align-items: center;
              justify-content: center;
              transform: rotate(${qiblahAngle}deg);
              border: 3px solid white;
              box-shadow: 0 0 10px rgba(0,0,0,0.3);
              font-size: 24px;
              font-weight: bold;
              color: white;
            ">
              ▲
            </div>
          `;

            // Create popup content
            const popupHTML = `
            <strong>Qiblah Direction</strong><br/>
            Angle: ${qiblahAngle.toFixed(1)}° from North<br/>
            <small style="color: green;">Your location (green arrow points to Mecca)</small>
          `;

            // Create Mapbox marker with custom element
            const qiblahMarker = new mapboxgl.Marker({ element: qiblahElement })
              .setLngLat([c.lon, c.lat])
              .setPopup(new mapboxgl.Popup({ offset: 25 }).setHTML(popupHTML))
              .addTo(map);

            qiblahMarker.togglePopup();

            // Draw a line from user to Mecca direction (visual aid)
            const angleRad = (qiblahAngle * Math.PI) / 180;
            const endLat = c.lat + Math.cos(angleRad) * 0.1;
            const endLon = c.lon + Math.sin(angleRad) * 0.1;

            // Remove old line if exists
            if (map.getSource("qiblah-line")) {
              map.removeLayer("qiblah-line-layer");
              map.removeSource("qiblah-line");
            }

            // Add line to map
            map.addSource("qiblah-line", {
              type: "geojson",
              data: {
                type: "Feature",
                geometry: {
                  type: "LineString",
                  coordinates: [
                    [c.lon, c.lat],
                    [endLon, endLat],
                  ],
                },
              },
            });

            map.addLayer({
              id: "qiblah-line-layer",
              type: "line",
              source: "qiblah-line",
              paint: {
                "line-color": "#32CD32",
                "line-width": 3,
                "line-opacity": 0.8,
                "line-dasharray": [2, 2],
              },
            });

