        // if this View button has a recommended package attached, open it (use sessionStorage so we don't overwrite user's explicit selection)
        const rec = b.dataset.recommendation;
        if (rec) {
          try {
            const obj = JSON.parse(decodeURIComponent(rec));
            // store temporarily in sessionStorage so it only lasts for this tab/session
