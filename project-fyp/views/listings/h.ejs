  .feature-card:nth-child(2) { animation-delay: 0.2s; }
  .feature-card:nth-child(3) { animation-delay: 0.3s; }

  .bookings-card::before,
  .feature-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: var(--gradient-primary);
    transition: height 0.3s ease;
  }

  .bookings-card::after,
  .feature-card::after {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(46, 125, 210, 0.1), transparent);
    transition: left 0.5s ease;
  }

  .bookings-card:hover::after,
  .feature-card:hover::after {
    left: 100%;
  }

  .bookings-card:hover,
  .feature-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 20px 40px rgba(46, 125, 210, 0.25);
    border-color: var(--primary-500);
  }

  .bookings-card:hover::before,
  .feature-card:hover::before {
    height: 6px;
  }

  .bookings-card {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .bookings-card .icon-pill {
    width: 52px;
    height: 52px;
    border-radius: var(--radius-lg);
    background: var(--gradient-primary);
    display: grid;
    place-items: center;
    color: #fff;
    font-size: 1.5rem;
    box-shadow: var(--shadow-primary);
    flex-shrink: 0;
    transition: all 0.3s ease;
  }

  .bookings-card:hover .icon-pill {
    transform: rotate(10deg) scale(1.1);
    box-shadow: 0 15px 35px rgba(46, 125, 210, 0.4);
  }

  .bookings-card h3 {
    margin: 0 0 0.5rem;
    font-size: 1.2rem;
    color: var(--gray-900);
    font-weight: 700;
    font-family: var(--font-display);
    transition: color 0.3s ease;
  }

  .bookings-card:hover h3 {
    color: var(--primary-600);
  }

  .bookings-card p {
    margin: 0;
    color: var(--gray-600);
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  .bookings-card .cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.875rem 1.75rem;
    background: var(--gradient-primary);
    color: white;
    border-radius: var(--radius-full);
    text-decoration: none;
    font-weight: 700;
    transition: all var(--transition-base);
    box-shadow: var(--shadow-md);
    margin-top: 1rem;
    position: relative;
    overflow: hidden;
  }

  .bookings-card .cta-btn::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 0;
    height: 0;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.3);
    transform: translate(-50%, -50%);
    transition: width 0.5s, height 0.5s;
  }

  .bookings-card .cta-btn:hover::before {
    width: 300px;
    height: 300px;
  }

  .bookings-card .cta-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 25px rgba(46, 125, 210, 0.4);
  }

  .bookings-card .cta-btn i {
    transition: transform 0.3s ease;
  }

  .bookings-card .cta-btn:hover i {
    transform: translateX(5px);
  }
    border-radius: var(--radius-full);
    text-decoration: none;
    font-weight: 800;
    box-shadow: var(--shadow-primary);
    transition: all var(--transition-base);
    white-space: nowrap;
    margin-top: 1rem;
    text-transform: uppercase;
    font-size: 0.9375rem;
