<% layout("/layouts/boiler") %>

<style>
  .booking-container {
    max-width: 900px;
    margin: 40px auto;
    padding: 20px;
  }

  .booking-header {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    padding: 30px;
    border-radius: 15px 15px 0 0;
    text-align: center;
  }

  .booking-header h1 {
    margin: 0;
    font-size: 2rem;
  }

  .booking-content {
    background: white;
    padding: 40px;
    border-radius: 0 0 15px 15px;
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.1);
  }

  .package-summary {
    background: #f8f9fa;
    padding: 25px;
    border-radius: 10px;
    margin-bottom: 30px;
    border-left: 5px solid #007bff;
  }

  .package-summary h3 {
    color: #333;
    margin-bottom: 15px;
  }

  .summary-row {
    display: flex;
    justify-content: space-between;
    padding: 10px 0;
    border-bottom: 1px solid #e0e0e0;
  }

  .summary-row:last-child {
    border-bottom: none;
    font-weight: bold;
    font-size: 1.2rem;
    color: #007bff;
  }

  .form-section {
    margin-bottom: 30px;
  }

  .form-section h4 {
    color: #495057;
    margin-bottom: 20px;
    padding-bottom: 10px;
    border-bottom: 2px solid #e9ecef;
  }

  .form-group {
    margin-bottom: 20px;
  }

  .form-group label {
    display: block;
    font-weight: 600;
    color: #495057;
    margin-bottom: 8px;
  }

  .form-group label .required {
    color: #dc3545;
  }

  .form-control {
    width: 100%;
    padding: 12px;
    border: 2px solid #e9ecef;
    border-radius: 8px;
    font-size: 1rem;
    transition: border-color 0.3s;
  }

  .form-control:focus {
    outline: none;
    border-color: #007bff;
    box-shadow: 0 0 0 3px rgba(0, 123, 255, 0.1);
  }

  .travelers-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }

  .dates-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }

  .price-breakdown {
    background: #e7f3ff;
    padding: 20px;
    border-radius: 10px;
    margin-top: 20px;
  }

  .price-row {
    display: flex;
    justify-content: space-between;
    padding: 8px 0;
  }

  .total-price {
    font-size: 1.5rem;
    font-weight: bold;
    color: #007bff;
    padding-top: 15px;
    border-top: 2px solid #007bff;
    margin-top: 10px;
  }

  .btn-submit {
    background: linear-gradient(45deg, #28a745, #20c997);
    color: white;
    border: none;
    padding: 15px 40px;
    font-size: 1.1rem;
    border-radius: 50px;
    cursor: pointer;
    width: 100%;
    font-weight: bold;
    transition: transform 0.2s;
  }

  .btn-submit:hover {
    transform: translateY(-2px);
    box-shadow: 0 5px 15px rgba(40, 167, 69, 0.3);
  }

  .btn-submit:disabled {
    background: #6c757d;
    cursor: not-allowed;
    transform: none;
  }

  .btn-back {
    display: inline-block;
    margin-top: 20px;
    color: #007bff;
    text-decoration: none;
    font-weight: 600;
  }

  .btn-back:hover {
    text-decoration: underline;
  }

  .alert {
    padding: 15px;
    border-radius: 8px;
    margin-bottom: 20px;
  }

  .alert-info {
    background: #d1ecf1;
    color: #0c5460;
    border: 1px solid #bee5eb;
  }

  .alert-danger {
    background: #f8d7da;
    color: #721c24;
    border: 1px solid #f5c6cb;
  }

  @media (max-width: 768px) {
    .travelers-grid,
    .dates-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<div class="booking-container">
  <div class="booking-header">
    <h1>📋 Complete Your Booking</h1>
    <p style="margin-top: 10px; font-size: 1.1rem">
      You're one step away from your dream vacation!
    </p>
  </div>

  <div class="booking-content">
    <!-- Loading indicator -->
    <div id="loadingIndicator" style="text-align: center; padding: 40px">
      <div style="font-size: 2rem; margin-bottom: 10px">⏳</div>
      <p>Loading booking details...</p>
    </div>

    <!-- Package Summary (will be populated by JavaScript from localStorage) -->
    <div id="packageSummaryContainer" style="display: none">
      <div class="package-summary">
        <h3>📦 Package Summary</h3>
        <div class="summary-row">
          <span><strong>Package:</strong></span>
          <span id="packageTitle">Loading...</span>
        </div>
        <div class="summary-row">
          <span><strong>Destination:</strong></span>
          <span id="packageDestination">Loading...</span>
        </div>
        <div class="summary-row">
          <span><strong>Duration:</strong></span>
          <span id="packageDuration">Loading...</span>
        </div>
        <div class="summary-row">
          <span><strong>Base Price:</strong></span>
          <span class="price" id="packagePriceDisplay">
            <span id="packageCurrency">USD</span>
            <span id="packagePrice">0</span>
          </span>
        </div>
      </div>
    </div>

    <!-- Booking Form -->
    <form action="/book" method="POST" id="bookingForm" style="display: none">
      <!-- Hidden fields - will be populated by JavaScript -->
      <input type="hidden" name="packageId" id="hiddenPackageId" value="" />
      <input
        type="hidden"
        name="packageDetails"
        id="hiddenPackageDetails"
        value=""
      />

      <!-- Travel Dates -->
      <div class="form-section">
        <h4>📅 Travel Dates</h4>
        <div class="dates-grid">
          <div class="form-group">
            <label for="startDate">
              Start Date <span class="required">*</span>
            </label>
            <input
              type="date"
              class="form-control"
              id="startDate"
              name="startDate"
              required
              min="<%= new Date().toISOString().split('T')[0] %>"
            />
          </div>
          <div class="form-group">
            <label for="endDate">
              End Date <span class="required">*</span>
            </label>
            <input
              type="date"
              class="form-control"
              id="endDate"
              name="endDate"
              required
              min="<%= new Date().toISOString().split('T')[0] %>"
            />
          </div>
        </div>
      </div>

      <!-- Number of Travelers -->
      <div class="form-section">
        <h4>👥 Number of Travelers</h4>
        <div class="travelers-grid">
          <div class="form-group">
            <label for="adults">
              Adults (18+) <span class="required">*</span>
            </label>
            <input
              type="number"
              class="form-control"
              id="adults"
              name="adults"
              min="1"
              max="20"
              value="1"
              required
            />
          </div>
          <div class="form-group">
            <label for="children">Children (Under 18)</label>
            <input
              type="number"
              class="form-control"
              id="children"
              name="children"
              min="0"
              max="20"
              value="0"
            />
          </div>
        </div>
      </div>

      <!-- Contact Information -->
      <div class="form-section">
        <h4>📞 Contact Information</h4>
        <div class="form-group">
          <label for="fullName">
            Full Name <span class="required">*</span>
          </label>
          <input
            type="text"
            class="form-control"
            id="fullName"
            name="fullName"
            placeholder="Enter your full name"
            value="<%= currentUser ? currentUser.username : '' %>"
            required
          />
        </div>
        <div class="form-group">
          <label for="email">
            Email Address <span class="required">*</span>
          </label>
          <input
            type="email"
            class="form-control"
            id="email"
            name="email"
            placeholder="your.email@example.com"
            value="<%= currentUser ? currentUser.email : '' %>"
            required
          />
        </div>
        <div class="form-group">
          <label for="phone">
            Phone Number <span class="required">*</span>
          </label>
          <input
            type="tel"
            class="form-control"
            id="phone"
            name="phone"
            placeholder="+1 234 567 8900"
            required
          />
        </div>
        <div class="form-group">
          <label for="specialRequests">Special Requests (Optional)</label>
          <textarea
            class="form-control"
            id="specialRequests"
            name="specialRequests"
            rows="4"
            placeholder="Any dietary restrictions, accessibility needs, or special preferences..."
          ></textarea>
        </div>
      </div>

      <!-- Price Breakdown -->
      <div class="price-breakdown">
        <h4 style="margin-top: 0; color: #333">💰 Price Breakdown</h4>
        <div class="price-row">
          <span>Base Package Price:</span>
          <span class="price" id="basePriceDisplay">
            <span id="basePriceCurrency">USD</span>
            <span id="basePrice">0</span>
          </span>
        </div>
        <div class="price-row">
          <span>Number of Travelers:</span>
          <span id="travelerCount">1</span>
        </div>
        <div class="price-row total-price">
          <span>Total Price:</span>
          <span class="price" id="totalPriceDisplay">
            <span id="totalPriceCurrency">USD</span>
            <span id="totalPrice">0</span>
          </span>
        </div>
      </div>

      <div class="alert alert-info" style="margin-top: 20px">
        <strong>ℹ️ Note:</strong> This is a booking request. Our team will
        review your request and contact you within 24 hours to confirm
        availability and payment details.
      </div>

      <button type="submit" class="btn-submit" id="submitBtn">
        🎉 Submit Booking Request
      </button>
    </form>

    <!-- Error message if no package selected -->
    <div class="alert alert-danger" id="noPackageError" style="display: none">
      <strong>⚠️ Error:</strong> No package selected. Please go back and select
      a package first. <br /><br />
      <a href="/" class="btn btn-primary">Go to Packages</a>
    </div>

    <!-- Submission Error Message -->
    <div class="alert alert-danger" id="submissionError" style="display: none">
      <strong>⚠️ Submission Error:</strong> <span id="errorMessage"></span>
      <br /><br />
      <button type="button" class="btn btn-primary" onclick="location.reload()">
        Try Again
      </button>
    </div>

    <a href="/" class="btn-back" id="backLink"> ← Back to Packages </a>
  </div>
</div>

<script>
  (function () {
    // Hide loading indicator
    const loadingIndicator = document.getElementById("loadingIndicator");

    // Load package data from localStorage
    let packageData = null;
    try {
      const stored = localStorage.getItem("selectedPackage");
      if (stored) {
        packageData = JSON.parse(stored);
        console.log("✅ Loaded package from localStorage:", packageData);
      } else {
        console.warn("⚠️ No package data found in localStorage");
      }
    } catch (err) {
      console.error("❌ Error loading package from localStorage:", err);
      showError("Failed to load package data: " + err.message);
    }

    // If no package data, show error
    if (!packageData) {
      loadingIndicator.style.display = "none";
      document.getElementById("noPackageError").style.display = "block";
      return;
    }

    // Validate package data has required fields
    if (!packageData.totalCost && !packageData.price) {
      console.error("❌ Invalid package data: missing price");
      loadingIndicator.style.display = "none";
      showError("Package data is incomplete. Please select a package again.");
      document.getElementById("noPackageError").style.display = "block";
      return;
    }

    // Hide loading, show the form and summary
    loadingIndicator.style.display = "none";
    document.getElementById("packageSummaryContainer").style.display = "block";
    document.getElementById("bookingForm").style.display = "block";

    function showError(message) {
      const errorDiv = document.getElementById("submissionError");
      const errorMsg = document.getElementById("errorMessage");
      errorMsg.textContent = message;
      errorDiv.style.display = "block";
    }

    // Populate package summary
    document.getElementById("packageTitle").textContent =
      packageData.packageTitle || packageData.title || "Custom Package";
    document.getElementById("packageDestination").textContent =
      packageData.destination || packageData.country || "Unknown";
    document.getElementById("packageDuration").textContent =
      packageData.duration || "Flexible";
    const summaryPrice =
      packageData.totalCostPKR ||
      packageData.totalPKR ||
      packageData.totalCost ||
      packageData.price ||
      0;
    const summaryCurrency =
      packageData.totalCostPKR || packageData.totalPKR
        ? "PKR"
        : packageData.currency || "USD";
    document.getElementById("packageCurrency").textContent = summaryCurrency;
    document.getElementById("packagePrice").textContent = summaryPrice.toLocaleString();

    // Populate hidden form fields
    document.getElementById("hiddenPackageId").value =
      packageData.packageId || packageData.id || Date.now().toString();
    document.getElementById("hiddenPackageDetails").value = encodeURIComponent(
      JSON.stringify(packageData)
    );

    // Update back link
    const context = JSON.parse(
      localStorage.getItem("selectedPackage_context") || "{}"
    );
    if (context.country) {
      document.getElementById(
        "backLink"
      ).href = `/packages?country=${context.country}`;
    }

    // Form elements
    const form = document.getElementById("bookingForm");
    const adultsInput = document.getElementById("adults");
    const childrenInput = document.getElementById("children");
    const startDateInput = document.getElementById("startDate");
    const endDateInput = document.getElementById("endDate");
    const basePriceEl = document.getElementById("basePrice");
    const totalPriceEl = document.getElementById("totalPrice");
    const basePriceCurrencyEl = document.getElementById("basePriceCurrency");
    const totalPriceCurrencyEl = document.getElementById("totalPriceCurrency");
    const travelerCountEl = document.getElementById("travelerCount");
    const submitBtn = document.getElementById("submitBtn");

    const basePrice =
      packageData.totalCostPKR ||
      packageData.totalPKR ||
      packageData.totalCost ||
      packageData.price ||
      0;
    const currency = packageData.totalCostPKR || packageData.totalPKR ? "PKR" : (packageData.currency || "USD");

    function updatePrice() {
      const adults = parseInt(adultsInput.value) || 0;
      const children = parseInt(childrenInput.value) || 0;

      travelerCountEl.textContent = `${adults} Adult${adults !== 1 ? "s" : ""}${
        children > 0 ? ` + ${children} Child${children !== 1 ? "ren" : ""}` : ""
      }`;

      // Calculate total (children pay 70% of adult price)
      const childRate = 0.7;
      const totalPrice = basePrice * adults + basePrice * children * childRate;

      basePriceEl.textContent = basePrice.toLocaleString();
      totalPriceEl.textContent = totalPrice.toLocaleString();
      basePriceCurrencyEl.textContent = currency;
      totalPriceCurrencyEl.textContent = currency;

      // Trigger currency conversion if available
      if (
        window.CurrencyConverter &&
        window.CurrencyConverter.convertAllPrices
      ) {
        setTimeout(() => window.CurrencyConverter.convertAllPrices(), 100);
      }
    }

    // Date validation
    startDateInput.addEventListener("change", function () {
      endDateInput.min = this.value;
      if (endDateInput.value && endDateInput.value < this.value) {
        endDateInput.value = this.value;
      }
    });

    endDateInput.addEventListener("change", function () {
      if (this.value < startDateInput.value) {
        alert("End date cannot be before start date!");
        this.value = startDateInput.value;
      }
    });

    // Update price on traveler count change
    adultsInput.addEventListener("input", updatePrice);
    childrenInput.addEventListener("input", updatePrice);

    // Form submission
    form.addEventListener("submit", function (e) {
      e.preventDefault();

      // Validation
      const startDate = new Date(startDateInput.value);
      const endDate = new Date(endDateInput.value);
      const today = new Date();
      today.setHours(0, 0, 0, 0);

      // Validate dates
      if (!startDateInput.value || !endDateInput.value) {
        alert("⚠️ Please select both start and end dates!");
        return;
      }

      if (startDate < today) {
        alert("⚠️ Start date cannot be in the past!");
        return;
      }

      if (endDate < startDate) {
        alert("⚠️ End date must be after start date!");
        return;
      }

      // Validate travelers
      const adults = parseInt(adultsInput.value) || 0;
      if (adults < 1) {
        alert("⚠️ At least one adult traveler is required!");
        return;
      }

      // Validate contact info
      const fullName = document.getElementById("fullName").value.trim();
      const email = document.getElementById("email").value.trim();
      const phone = document.getElementById("phone").value.trim();

      if (!fullName || !email || !phone) {
        alert("⚠️ Please fill in all required contact information!");
        return;
      }

      // Validate email format
      const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
      if (!emailRegex.test(email)) {
        alert("⚠️ Please enter a valid email address!");
        return;
      }

      // Validate package data is still available
      if (!packageData || !packageData.totalCost) {
        alert("⚠️ Package data is missing. Please select a package again.");
        showError(
          "Package data lost. Please go back and select a package again."
        );
        return;
      }

      // Disable submit button and show loading state
      submitBtn.disabled = true;
      submitBtn.textContent = "⏳ Submitting your booking...";
      submitBtn.style.opacity = "0.7";

      console.log("📤 Submitting booking form...");

      // Submit the form
      try {
        form.submit();
      } catch (err) {
        console.error("❌ Form submission error:", err);
        submitBtn.disabled = false;
        submitBtn.textContent = "🎉 Submit Booking Request";
        submitBtn.style.opacity = "1";
        alert("⚠️ Error submitting form. Please try again.");
      }
    });

    // Initial price calculation
    updatePrice();
  })();
</script>
