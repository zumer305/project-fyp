
<% const hasSuccess = Array.isArray(success) ? success.length : !!success; %>
<%if(hasSuccess) {%>
<div class="alert alert-success alert-dismissible fade show col-6 offset-3" role="alert">
    <%= Array.isArray(success) ? success.join(" ") : success %>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="close"></button>
</div>
<%}%>



<% const hasError = Array.isArray(error) ? error.length : !!error; %>
<%if(hasError) {%>
<div class="alert alert-danger alert-dismissible fade show col-6 offset-3" role="alert">
    <%= Array.isArray(error) ? error.join(" ") : error %>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="close"></button>
</div>
<%}%>